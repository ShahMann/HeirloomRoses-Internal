{% comment %}
  Section: Dynamic Zone Collection
  Shows products from user's hardiness zone collection
{% endcomment %}
{% assign section_id = section.id | replace: '_', '' | downcase %}

<div class="zone-collection-wrapper">
  <div class="page-width">
    <div class="zone-collection-layout-{{ section_id }}">
      {% if section.settings.show_promotional_section %}
        <div class="zone-promotional-section-{{ section_id }}">
          {% if section.settings.promotional_image %}
            <div class="zone-promotional-image-{{ section_id }}" style="background-image: url('{{ section.settings.promotional_image | image_url: width: 800 }}');">
              <div class="zone-promotional-overlay-{{ section_id }}">
                {% if section.settings.promotional_label != blank %}
                  <div class="zone-promotional-label-{{ section_id }}">{{ section.settings.promotional_label }}</div>
                {% endif %}
                {% if section.settings.promotional_heading != blank %}
                  <h2 class="zone-promotional-heading-{{ section_id }}">{{ section.settings.promotional_heading }}</h2>
                {% endif %}
                {% if section.settings.promotional_text != blank %}
                  <div class="zone-promotional-text-{{ section_id }}">{{ section.settings.promotional_text }}</div>
                {% endif %}
                {% if section.settings.promotional_button_text != blank and section.settings.promotional_button_link != blank %}
                  <a href="{{ section.settings.promotional_button_link }}" class="zone-promotional-button-{{ section_id }}">
                    {{ section.settings.promotional_button_text }}
                  </a>
                {% endif %}
                {% if section.settings.show_promotional_icon %}
                  <div class="zone-promotional-icon-{{ section_id }}">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" fill="currentColor"/>
                    </svg>
                  </div>
                {% endif %}
              </div>
            </div>
          {% else %}
            <div class="zone-promotional-image-{{ section_id }} zone-promotional-image-placeholder-{{ section_id }}">
              <div class="zone-promotional-overlay-{{ section_id }}">
                {% if section.settings.promotional_label != blank %}
                  <div class="zone-promotional-label-{{ section_id }}">{{ section.settings.promotional_label }}</div>
                {% endif %}
                {% if section.settings.promotional_heading != blank %}
                  <h2 class="zone-promotional-heading-{{ section_id }}">{{ section.settings.promotional_heading }}</h2>
                {% endif %}
                {% if section.settings.promotional_text != blank %}
                  <div class="zone-promotional-text-{{ section_id }}">{{ section.settings.promotional_text }}</div>
                {% endif %}
                {% if section.settings.promotional_button_text != blank and section.settings.promotional_button_link != blank %}
                  <a href="{{ section.settings.promotional_button_link }}" class="zone-promotional-button-{{ section_id }}">
                    {{ section.settings.promotional_button_text }}
                  </a>
                {% endif %}
                {% if section.settings.show_promotional_icon %}
                  <div class="zone-promotional-icon-{{ section_id }}">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" fill="currentColor"/>
                    </svg>
                  </div>
                {% endif %}
              </div>
            </div>
          {% endif %}
        </div>
      {% endif %}
      <div class="zone-products-section-{{ section_id }}">
        <dynamic-zone-collection 
          data-products-limit="{{ section.settings.products_limit }}"
          data-section-title="{{ section.settings.section_title }}"
          data-shop-all-text="{{ section.settings.shop_all_text }}"
          data-cards-desktop="{{ section.settings.cards_desktop }}"
          data-cards-mobile="{{ section.settings.cards_mobile }}"
          data-section-id="{{ section_id }}"
          data-promotional-text="{{ section.settings.promotional_text }}"
          data-use-dynamic-text="{{ section.settings.use_dynamic_zone_text }}">
        </dynamic-zone-collection>
      </div>
    </div>
  </div>
</div>

{% style %}
  .zone-collection-wrapper {
    padding: {{ section.settings.section_padding_top }}px 0 {{ section.settings.section_padding_bottom }}px;
    background-color: {{ section.settings.background_color }};
  }

  .zone-collection-layout-{{ section_id }} {
    display: flex;
    gap: {{ section.settings.promotional_spacing }}px;
    align-items: flex-start;
  }

  .zone-promotional-section-{{ section_id }} {
    flex: 0 0 {{ section.settings.promotional_width }}%;
    position: relative;
  }

  .zone-promotional-image-{{ section_id }} {
    position: relative;
    width: 100%;
    min-height: 500px;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    border-radius: {{ section.settings.promotional_border_radius }}px;
    overflow: hidden;
  }

  .zone-promotional-image-placeholder-{{ section_id }} {
    background-color: {{ section.settings.promotional_background_color }};
  }

  .zone-promotional-overlay-{{ section_id }} {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: {{ section.settings.promotional_padding }}px;
    background: linear-gradient(to bottom, rgba(0,0,0,0) 0%, rgba(0,0,0,{{ section.settings.promotional_overlay_opacity | divided_by: 100.0 }}) 100%);
  }

  .zone-promotional-label-{{ section_id }} {
    font-size: {{ section.settings.promotional_label_size }}px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: {{ section.settings.promotional_label_color }};
    margin-bottom: {{ section.settings.promotional_label_spacing }}px;
    font-family: Helvetica, Arial, sans-serif;
  }

  .zone-promotional-heading-{{ section_id }} {
    font-size: {{ section.settings.promotional_heading_size }}px;
    font-weight: {{ section.settings.promotional_heading_weight }};
    color: {{ section.settings.promotional_heading_color }};
    margin: 0 0 {{ section.settings.promotional_heading_spacing }}px 0;
    line-height: 1.2;
    font-family: Georgia, serif;
  }

  .zone-promotional-text-{{ section_id }} {
    font-size: {{ section.settings.promotional_text_size }}px;
    color: {{ section.settings.promotional_text_color }};
    margin-bottom: {{ section.settings.promotional_text_spacing }}px;
    line-height: 1.5;
    max-width: 90%;
    font-family: Helvetica, Arial, sans-serif;
  }

  .zone-promotional-button-{{ section_id }} {
    display: inline-block;
    padding: {{ section.settings.promotional_button_padding_vertical }}px {{ section.settings.promotional_button_padding_horizontal }}px;
    background-color: {{ section.settings.promotional_button_background }};
    color: {{ section.settings.promotional_button_text_color }};
    text-decoration: none;
    font-size: {{ section.settings.promotional_button_text_size }}px;
    font-weight: 600;
    text-transform: uppercase;
    border-radius: {{ section.settings.promotional_button_border_radius }}px;
    transition: opacity 0.3s ease, transform 0.2s ease;
    margin-top: {{ section.settings.promotional_button_spacing }}px;
    font-family: Helvetica, Arial, sans-serif;
  }

  .zone-promotional-button-{{ section_id }}:hover {
    opacity: 0.9;
    transform: translateY(-2px);
  }

  .zone-promotional-icon-{{ section_id }} {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    width: {{ section.settings.promotional_icon_size }}px;
    height: {{ section.settings.promotional_icon_size }}px;
    color: {{ section.settings.promotional_icon_color }};
  }

  .zone-promotional-icon-{{ section_id }} svg {
    width: 100%;
    height: 100%;
  }

  .zone-products-section-{{ section_id }} {
    flex: 1;
    min-width: 0;
  }

  .dynamic-zone-collection {
    width: 100%;
  }

  .zone-collection-header-{{ section_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: {{ section.settings.title_spacing }}px;
    flex-wrap: wrap;
    gap: 20px;
  }

  .zone-collection-title-{{ section_id }} {
    font-size: {{ section.settings.title_size_desktop }}px;
    font-weight: 600;
    margin: 0;
    color: {{ section.settings.title_color }};
    text-align: {{ section.settings.title_alignment_desktop }};
    flex-grow: 1;
  }

  .zone-collection-title-{{ section_id }} .zone-link {
    text-decoration: underline;
  }

  .zone-shop-all-link-{{ section_id }} {
    font-size: 16px;
    font-weight: 500;
    text-decoration: none;
    color: {{ section.settings.link_color }};
    border-bottom: 2px solid {{ section.settings.link_color }};
    padding-bottom: 4px;
    transition: opacity 0.3s ease;
  }

  .zone-shop-all-link-{{ section_id }}:hover {
    opacity: 0.7;
  }

  .zone-shop-all-link-{{ section_id }}.hide {
    display: none;
  }

  .zone-collection-arrows-{{ section_id }} {
    display: flex;
    gap: 8px;
  }

  .zone-collection-arrow-{{ section_id }} {
    width: {{ section.settings.arrow_size }}px;
    height: {{ section.settings.arrow_size }}px;
    background-color: {{ section.settings.arrow_color }};
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.3s ease;
    color: {{ section.settings.arrow_icon_color }};
  }

  .zone-collection-arrow-{{ section_id }}:hover {
    background-color: {{ section.settings.arrow_hover_color }};
  }

  .zone-collection-arrow-{{ section_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .zone-collection-arrow-{{ section_id }}:focus-visible {
    outline: 2px solid {{ section.settings.arrow_color }};
    outline-offset: 2px;
  }

  .zone-collection-arrow-{{ section_id }} svg {
    width: calc({{ section.settings.arrow_size }}px * 0.5);
    height: calc({{ section.settings.arrow_size }}px * 0.5);
  }

  .zone-products-scroll-container-{{ section_id }} {
    position: relative;
    overflow: hidden;
  }

  .zone-products-grid-{{ section_id }} {
    display: flex;
    gap: {{ section.settings.card_spacing }}px;
    transition: transform 0.3s ease;
    will-change: transform;
  }

  .zone-products-grid-{{ section_id }} .grid-item {
    flex: 0 0 calc((100% - ({{ section.settings.cards_desktop | minus: 1 }} * {{ section.settings.card_spacing }}px)) / {{ section.settings.cards_desktop }});
  }

  .loading-products,
  .error-message {
    flex: 1 1 100%;
    text-align: center;
    padding: 60px 20px;
    font-size: 18px;
    color: #666;
  }

  .zone-products-grid-{{ section_id }} .grid-product {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .zone-products-grid-{{ section_id }} .product-grid-item {
    height: 100%;
    transition: transform 0.2s ease;
    border: none;
  }

  .zone-products-grid-{{ section_id }} .grid-product:hover .product-grid-item {
    transform: translateY(-2px);
  }

  .zone-products-grid-{{ section_id }} .grid-product:focus-visible {
    outline: 2px solid {{ section.settings.title_color }};
    outline-offset: 2px;
  }

  .zone-products-grid-{{ section_id }} .grid-product__image-wrap {
    position: relative;
    width: 100%;
    margin-bottom: 12px;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 8px;
    background-color: #f5f5f5;
  }

  .zone-products-grid-{{ section_id }} .grid__image-ratio {
    width: 100%;
    height: 100%;
  }

  .zone-products-grid-{{ section_id }} .grid__image-contain {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .zone-products-grid-{{ section_id }} .grid-product__tags {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .zone-products-grid-{{ section_id }} .grid-product__tag {
    padding: 6px 12px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    background: {{ section.settings.badge_color }};
    color: #fff;
    width: fit-content;
  }

  .zone-products-grid-{{ section_id }} .grid-product__tag--sold-out {
    background: #999;
  }

  .zone-products-grid-{{ section_id }} .grid-product__tag--sale {
    background: {{ section.settings.badge_color }};
  }

  .zone-products-grid-{{ section_id }} .grid-item__meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
  }

  .zone-products-grid-{{ section_id }} .grid-item__meta-main {
    flex: 1;
  }

  .zone-products-grid-{{ section_id }} .grid-product__title {
    font-family: Helvetica, Arial, sans-serif;
    font-size: 16px !important;
    color: #000000;
    margin: 0;
    line-height: 1.4;
    text-align: center;
    font-weight: 700;
  }

  .zone-products-grid-{{ section_id }} .grid-item__meta-secondary {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
    margin-top: 4px;
  }

  .zone-products-grid-{{ section_id }} .grid-product__price {
    display: flex;
    align-items: center;
    gap: 8px;
    justify-content: center;
  }

  .zone-products-grid-{{ section_id }} .grid-product__price--current {
    font-size: {{ section.settings.card_text_size_desktop | plus: 2 }}px;
    font-weight: 600;
    color: {{ section.settings.price_color }};
  }

  .zone-products-grid-{{ section_id }} .grid-product__price--original {
    font-size: {{ section.settings.card_text_size_desktop }}px;
    color: #999;
    text-decoration: line-through;
  }

  .zone-products-grid-{{ section_id }} .wishlist-floating-btn {
    position: relative;
  }

  .hide {
    display: none !important;
  }

  @media screen and (max-width: 749px) {
    .zone-collection-wrapper {
      padding: {{ section.settings.section_padding_top | times: 0.7 | round }}px 0 {{ section.settings.section_padding_bottom | times: 0.7 | round }}px;
    }

    .zone-collection-layout-{{ section_id }} {
      flex-direction: column;
      gap: {{ section.settings.promotional_spacing_mobile }}px;
    }

    .zone-promotional-section-{{ section_id }} {
      flex: 1 1 100%;
      width: 100%;
    }

    .zone-promotional-image-{{ section_id }} {
      min-height: {{ section.settings.promotional_height_mobile }}px;
    }

    .zone-promotional-label-{{ section_id }} {
      font-size: {{ section.settings.promotional_label_size_mobile }}px;
    }

    .zone-promotional-heading-{{ section_id }} {
      font-size: {{ section.settings.promotional_heading_size_mobile }}px;
    }

    .zone-promotional-text-{{ section_id }} {
      font-size: {{ section.settings.promotional_text_size_mobile }}px;
    }

    .zone-promotional-button-{{ section_id }} {
      font-size: {{ section.settings.promotional_button_text_size_mobile }}px;
      padding: {{ section.settings.promotional_button_padding_vertical_mobile }}px {{ section.settings.promotional_button_padding_horizontal_mobile }}px;
    }

    .zone-promotional-icon-{{ section_id }} {
      width: {{ section.settings.promotional_icon_size_mobile }}px;
      height: {{ section.settings.promotional_icon_size_mobile }}px;
    }

    .zone-products-section-{{ section_id }} {
      flex: 1 1 100%;
      width: 100%;
    }

    .zone-collection-title-{{ section_id }} {
      font-size: {{ section.settings.title_size_mobile }}px;
      text-align: {{ section.settings.title_alignment_mobile }};
    }

    .zone-products-grid-{{ section_id }} .grid-item {
      flex: 0 0 calc((100% - ({{ section.settings.cards_mobile | minus: 1 }} * {{ section.settings.card_spacing }}px)) / {{ section.settings.cards_mobile }});
      padding: 0;
      margin: 0;
    }

    .zone-products-grid-{{ section_id }} .grid-product__title {
      font-size: {{ section.settings.card_text_size_mobile }}px;
    }

    .zone-products-grid-{{ section_id }} .grid-product__price--current {
      font-size: {{ section.settings.card_text_size_mobile | plus: 2 }}px;
    }

    .zone-products-grid-{{ section_id }} .grid-product__price--original {
      font-size: {{ section.settings.card_text_size_mobile }}px;
    }

    .zone-collection-arrows-{{ section_id }} {
      {% unless section.settings.show_arrows_mobile %}
        display: none;
      {% endunless %}
    }

    .zone-products-scroll-container-{{ section_id }} {
      touch-action: pan-x;
      -webkit-overflow-scrolling: touch;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Dynamic Zone Collection",
  "tag": "section",
  "class": "section-zone-collection",
  "settings": [
    {
      "type": "header",
      "content": "Promotional Section"
    },
    {
      "type": "checkbox",
      "id": "show_promotional_section",
      "label": "Show promotional section",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "promotional_image",
      "label": "Promotional Image"
    },
    {
      "type": "color",
      "id": "promotional_background_color",
      "label": "Background Color (if no image)",
      "default": "#f5e6e0"
    },
    {
      "type": "text",
      "id": "promotional_label",
      "label": "Label Text",
      "default": "COLLECTION"
    },
    {
      "type": "text",
      "id": "promotional_heading",
      "label": "Heading Text",
      "default": "Curated for You"
    },
    {
      "type": "richtext",
      "id": "promotional_text",
      "label": "Description Text",
      "default": "<p>Based on your location in Zone 7, these could be great for your garden.</p>"
    },
    {
      "type": "checkbox",
      "id": "use_dynamic_zone_text",
      "label": "Use dynamic zone in text",
      "default": true,
      "info": "Replace {zone} in text with actual zone number"
    },
    {
      "type": "text",
      "id": "promotional_button_text",
      "label": "Button Text",
      "default": "VIEW ALL"
    },
    {
      "type": "url",
      "id": "promotional_button_link",
      "label": "Button Link"
    },
    {
      "type": "checkbox",
      "id": "show_promotional_icon",
      "label": "Show decorative icon",
      "default": true
    },
    {
      "type": "header",
      "content": "Promotional Layout"
    },
    {
      "type": "range",
      "id": "promotional_width",
      "min": 20,
      "max": 50,
      "step": 5,
      "unit": "%",
      "label": "Promotional section width (desktop)",
      "default": 30
    },
    {
      "type": "range",
      "id": "promotional_spacing",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Spacing between sections (desktop)",
      "default": 30
    },
    {
      "type": "range",
      "id": "promotional_spacing_mobile",
      "min": 0,
      "max": 40,
      "step": 5,
      "unit": "px",
      "label": "Spacing between sections (mobile)",
      "default": 20
    },
    {
      "type": "range",
      "id": "promotional_border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 12
    },
    {
      "type": "range",
      "id": "promotional_padding",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Content padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "promotional_overlay_opacity",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 10,
      "info": "Dark overlay on image for better text readability"
    },
    {
      "type": "header",
      "content": "Promotional Text Styles"
    },
    {
      "type": "range",
      "id": "promotional_label_size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Label size (desktop)",
      "default": 12
    },
    {
      "type": "range",
      "id": "promotional_label_size_mobile",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Label size (mobile)",
      "default": 11
    },
    {
      "type": "color",
      "id": "promotional_label_color",
      "label": "Label color",
      "default": "#5a3a2e"
    },
    {
      "type": "range",
      "id": "promotional_label_spacing",
      "min": 5,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Label spacing",
      "default": 10
    },
    {
      "type": "range",
      "id": "promotional_heading_size",
      "min": 24,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading size (desktop)",
      "default": 36
    },
    {
      "type": "range",
      "id": "promotional_heading_size_mobile",
      "min": 20,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Heading size (mobile)",
      "default": 28
    },
    {
      "type": "range",
      "id": "promotional_heading_weight",
      "min": 400,
      "max": 700,
      "step": 100,
      "label": "Heading weight",
      "default": 600
    },
    {
      "type": "color",
      "id": "promotional_heading_color",
      "label": "Heading color",
      "default": "#5a3a2e"
    },
    {
      "type": "range",
      "id": "promotional_heading_spacing",
      "min": 10,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Heading spacing",
      "default": 16
    },
    {
      "type": "range",
      "id": "promotional_text_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text size (desktop)",
      "default": 16
    },
    {
      "type": "range",
      "id": "promotional_text_size_mobile",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Text size (mobile)",
      "default": 14
    },
    {
      "type": "color",
      "id": "promotional_text_color",
      "label": "Text color",
      "default": "#5a3a2e"
    },
    {
      "type": "range",
      "id": "promotional_text_spacing",
      "min": 10,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Text spacing",
      "default": 20
    },
    {
      "type": "header",
      "content": "Promotional Button"
    },
    {
      "type": "range",
      "id": "promotional_button_text_size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Button text size (desktop)",
      "default": 14
    },
    {
      "type": "range",
      "id": "promotional_button_text_size_mobile",
      "min": 12,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Button text size (mobile)",
