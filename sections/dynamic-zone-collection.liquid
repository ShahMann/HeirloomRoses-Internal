{% comment %}
  Section: Dynamic Zone Collection
  Shows products from user's hardiness zone collection
{% endcomment %}
{% assign section_id = section.id | replace: '_', '' | downcase %}
{% assign use_theme_colors = section.settings.use_theme_colors %}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<div class="zone-collection-wrapper section color-{{ section.settings.color_scheme }} {% if use_theme_colors %}use-theme-colors{% endif %}">
  <div class="page-width">
    <div class="zone-collection-layout">
      {% if section.settings.show_promotional_section %}
        <div class="zone-promotional-section">
          {% if section.settings.promotional_image %}
            <div
              class="zone-promotional-image"
              style="background-image: url('{{ section.settings.promotional_image | image_url: width: 800 }}');"
            >
              <div class="zone-promotional-overlay">
                {% if section.settings.promotional_label != blank %}
                  <div class="zone-promotional-label">{{ section.settings.promotional_label }}</div>
                {% endif %}
                <div class="zone-promotional-heading-container">
                  {% if section.settings.promotional_heading != blank %}
                    <h2 class="zone-promotional-heading">{{ section.settings.promotional_heading }}</h2>
                  {% endif %}
                  {% if section.settings.promotional_text != blank %}
                    <div class="zone-promotional-text">{{ section.settings.promotional_text }}</div>
                  {% endif %}
                  {% comment %} {% if section.settings.promotional_button_text != blank and section.settings.promotional_button_link != blank %} {% endcomment %}
                  <a
                    href="{{ section.settings.promotional_button_link }}"
                    class="zone-promotional-button button button-secondary"
                  >
                    {{ section.settings.promotional_button_text }}
                  </a>
                  {% comment %} {% endif %} {% endcomment %}
                </div>
                {% if section.settings.show_promotional_icon %}
                  <div class="zone-promotional-icon">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" fill="currentColor"/>
                    </svg>
                  </div>
                {% endif %}
              </div>
            </div>
          {% else %}
            <div class="zone-promotional-image zone-promotional-image-placeholder">
              <div class="zone-promotional-overlay">
                {% if section.settings.promotional_label != blank %}
                  <div class="zone-promotional-label">{{ section.settings.promotional_label }}</div>
                {% endif %}
                <div class="zone-promotional-heading-container">
                  {% if section.settings.promotional_heading != blank %}
                    <h2 class="zone-promotional-heading">{{ section.settings.promotional_heading }}</h2>
                  {% endif %}
                  {% if section.settings.promotional_text != blank %}
                    <div class="zone-promotional-text">{{ section.settings.promotional_text }}</div>
                  {% endif %}
                  {% if section.settings.promotional_button_text != blank
                    and section.settings.promotional_button_link != blank
                  %}
                    <a href="{{ section.settings.promotional_button_link }}" class="zone-promotional-button">
                      {{ section.settings.promotional_button_text }}
                    </a>
                  {% endif %}
                </div>
                {% if section.settings.show_promotional_icon %}
                  <div class="zone-promotional-icon">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" fill="currentColor"/>
                    </svg>
                  </div>
                {% endif %}
              </div>
            </div>
          {% endif %}
        </div>
      {% endif %}
      <div class="zone-products-section">
        <dynamic-zone-collection
          data-products-limit="{{ section.settings.products_limit }}"
          data-section-title="{{ section.settings.section_title }}"
          data-shop-all-text="{{ section.settings.shop_all_text }}"
          data-cards-desktop="{{ section.settings.cards_desktop }}"
          data-cards-mobile="{{ section.settings.cards_mobile }}"
          data-section-id="{{ section_id }}"
          data-promotional-text="{{ section.settings.promotional_text }}"
          data-use-dynamic-text="{{ section.settings.use_dynamic_zone_text }}"
        >
        </dynamic-zone-collection>
      </div>
    </div>
  </div>
</div>

{% style %}
  .zone-collection-wrapper {
    padding: 8px 16px;
    {% if use_theme_colors %}
      background: rgb(var(--color-background));
    {% else %}
      background: {{ section.settings.background_color }};
    {% endif %}
  }
  .zone-collection-layout {
    display: flex;
    gap: 32px;
    align-items: stretch;
  }

  .zone-promotional-heading {
    margin: 0;
  }
  .zone-promotional-heading-container {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: center;  
  }

  .zone-promotional-label {
    font-family: "SeasonSans-Medium", sans-serif;
    font-weight: 550;
    font-size: 14px;
    line-height: 140%;
    letter-spacing: 12%;
  }

  .zone-promotional-heading {
    font-family: "SeasonMix-Light", sans-serif;
    font-weight: 300;
    font-size: 48px;
    line-height: 90%;
    letter-spacing: 0%;
  }

  .zone-promotional-text {
    font-family: "SeasonSans-Regular", sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 120%;
    letter-spacing: 3%;
  }

  .zone-promotional-heading-container .button-secondary {
    font-size: 10px;
  }

  .zone-promotional-section {
    flex: 0 0 30%;
    display: flex;
  }

  .zone-promotional-image {
    position: relative;
    width: 100%;
    min-height: 680px;
    border-radius: 28px;
    overflow: hidden;
    background-size: cover;
    background-position: center;
  }

  .zone-promotional-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-evenly;
    align-items: center;
    padding: 32px;
    text-align: center;
    background: rgba(255,255,255,0.45);
  }
  .zone-products-section {
    flex: 1;
    min-width: 0;
  }

  .zone-products-scroll-container {
    overflow: visible;
  }

  .zone-products-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr); /* 3 cards desktop */
    gap: {{ section.settings.card_spacing }}px;
  }

  .grid-product__image-wrap {
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 8px;
  }

  .grid__image-contain {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .grid-product:hover .grid__image-contain {
    transform: scale(1.05);
  }

  .grid-item__meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px;
  }

  .grid-product__title {
    font-family: "SeasonSans-Regular", sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 120%;
    letter-spacing: 3%;
    color: var(--color-red);
  }

  .grid-product__price {
    justify-content: center;
    font-family: "SeasonSans-Medium", sans-serif;
    font-weight: 550;
    font-size: 10px;
    line-height: 140%;
    letter-spacing: 12%;
    color: var(--color-brown);
  }
  
  .grid-item__meta-main {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 8px;
  }

  .grid-item__meta-secondary .wishlist-floating-btn button {
    border: none;
    background: transparent;
  }

  .grid-item__meta-secondary .wishlist-floating-btn svg.icon-block__media {
    width: 13px;
    color: var(--color-red);
  }


  /* MOBILE */
  @media (max-width: 749px) {

    .zone-collection-layout {
      flex-direction: column;
    }

    .zone-promotional-section {
      flex: 1 1 100%;
    }

    .zone-promotional-image {
      min-height: 480px;
      border-radius: 24px;
    }

    /* 2 columns mobile */
    .zone-products-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .grid-product__title {
      font-size: 14px;
    }
    .zone-promotional-heading {
      font-size: 36px;
    }
    .zone-promotional-text {
      font-size: 12px;
      letter-spacing: 4%;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Dynamic Zone Collection",
  "tag": "section",
  "class": "section-zone-collection",
  "settings": [
    {
      "type": "header",
      "content": "Promotional Section"
    },
    {
      "type": "checkbox",
      "id": "show_promotional_section",
      "label": "Show promotional section",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "promotional_image",
      "label": "Promotional Image"
    },
    {
      "type": "color",
      "id": "promotional_background_color",
      "label": "Background Color (if no image)",
      "default": "#f5e6e0"
    },
    {
      "type": "text",
      "id": "promotional_label",
      "label": "Label Text",
      "default": "COLLECTION"
    },
    {
      "type": "text",
      "id": "promotional_heading",
      "label": "Heading Text",
      "default": "Curated for You"
    },
    {
      "type": "richtext",
      "id": "promotional_text",
      "label": "Description Text",
      "default": "<p>Based on your location in Zone 7, these could be great for your garden.</p>"
    },
    {
      "type": "checkbox",
      "id": "use_dynamic_zone_text",
      "label": "Use dynamic zone in text",
      "default": true,
      "info": "Replace {zone} in text with actual zone number"
    },
    {
      "type": "text",
      "id": "promotional_button_text",
      "label": "Button Text",
      "default": "VIEW ALL"
    },
    {
      "type": "url",
      "id": "promotional_button_link",
      "label": "Button Link"
    },
    {
      "type": "checkbox",
      "id": "show_promotional_icon",
      "label": "Show decorative icon",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "products_limit",
      "min": 4,
      "max": 12,
      "step": 1,
      "label": "Number of Products",
      "default": 8
    },
    {
      "type": "range",
      "id": "cards_desktop",
      "min": 3,
      "max": 6,
      "step": 1,
      "label": "Cards visible desktop",
      "default": 4
    },
    {
      "type": "select",
      "id": "cards_mobile",
      "label": "Cards visible mobile",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "card_spacing",
      "min": 10,
      "max": 40,
      "step": 5,
      "unit": "px",
      "label": "Card spacing",
      "default": 20
    },
    {
      "type": "header",
      "content": "Section style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Theme colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "use_theme_colors",
      "label": "Use theme color scheme for button and text",
      "info": "When off, use custom colors below",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Dynamic Zone Collection"
    }
  ]
}
{% endschema %}
{% comment %}
  position: relative;
  width: 100%;
  margin-bottom: 12px;
  aspect-ratio: 1;
  overflow: hidden;
  border-radius: 8px;
  background-color: #f5f5f5;
{% endcomment %}
