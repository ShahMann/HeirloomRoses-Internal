{% comment %}
  Section: Dynamic Zone Collection
  Shows products from user's hardiness zone collection
{% endcomment %}
{% assign section_id = section.id | replace: '_', '' | downcase %}
{% assign use_theme_colors = section.settings.use_theme_colors %}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<div class="zone-collection-wrapper section color-{{ section.settings.color_scheme }} {% if use_theme_colors %}use-theme-colors{% endif %}">
  <div class="page-width">
    <div class="zone-collection-layout">
      {% if section.settings.show_promotional_section %}
        <div class="zone-promotional-section">
          {% if section.settings.promotional_image %}
            <div
              class="zone-promotional-image"
              style="background-image: url('{{ section.settings.promotional_image | image_url: width: 800 }}');"
            >
              <div class="zone-promotional-overlay">
                {% if section.settings.promotional_label != blank %}
                  <div class="zone-promotional-label">{{ section.settings.promotional_label }}</div>
                {% endif %}
                <div class="zone-promotional-heading-container">
                  {% if section.settings.promotional_heading != blank %}
                    <h2 class="zone-promotional-heading">{{ section.settings.promotional_heading }}</h2>
                  {% endif %}
                  {% if section.settings.promotional_text != blank %}
                    {% assign promo_text_with_placeholder = section.settings.promotional_text | replace: '{zone}', '<span class="zone-dynamic-number" data-zone-placeholder></span>' %}
                    <div class="zone-promotional-text">{{ promo_text_with_placeholder }}</div>
                  {% endif %}
                  <a
                    href="#"
                    class="zone-promotional-button button button-secondary"
                  >
                    {{ section.settings.promotional_button_text }}
                  </a>
                  {% comment %} {% endif %} {% endcomment %}
                </div>
                {% if section.settings.show_promotional_icon %}
                  <div class="zone-promotional-icon">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" fill="currentColor"/>
                    </svg>
                  </div>
                {% endif %}
              </div>
            </div>
          {% else %}
            <div class="zone-promotional-image zone-promotional-image-placeholder">
              <div class="zone-promotional-overlay">
                {% if section.settings.promotional_label != blank %}
                  <div class="zone-promotional-label">{{ section.settings.promotional_label }}</div>
                {% endif %}
                <div class="zone-promotional-heading-container">
                  {% if section.settings.promotional_heading != blank %}
                    <h2 class="zone-promotional-heading">{{ section.settings.promotional_heading }}</h2>
                  {% endif %}
                  {% if section.settings.promotional_text != blank %}
                    {% assign promo_text_with_placeholder = section.settings.promotional_text | replace: '{zone}', '<span class="zone-dynamic-number" data-zone-placeholder></span>' %}
                    <div class="zone-promotional-text">{{ promo_text_with_placeholder }}</div>
                  {% endif %}
                  {% if section.settings.promotional_button_text != blank %}
                    <a href="#" class="zone-promotional-button">
                      {{ section.settings.promotional_button_text }}
                    </a>
                  {% endif %}
                </div>
                {% if section.settings.show_promotional_icon %}
                  <div class="zone-promotional-icon">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" fill="currentColor"/>
                    </svg>
                  </div>
                {% endif %}
              </div>
            </div>
          {% endif %}
        </div>
      {% endif %}
      <div class="zone-products-section">
        <dynamic-zone-collection
          data-products-limit="{{ section.settings.products_limit }}"
          data-section-title="{{ section.settings.section_title }}"
          data-shop-all-text="{{ section.settings.shop_all_text }}"
          data-cards-desktop="{{ section.settings.cards_desktop }}"
          data-cards-mobile="{{ section.settings.cards_mobile }}"
          data-section-id="{{ section_id }}"
        >
        </dynamic-zone-collection>
      </div>
    </div>
  </div>
</div>

{% style %}
  .zone-collection-wrapper {
    padding: 8px 16px;
    {% if use_theme_colors %}
      background: rgb(var(--color-background));
    {% else %}
      background: {{ section.settings.background_color }};
    {% endif %}
  }
  .zone-collection-layout {
    display: flex;
    gap: 32px;
    align-items: stretch;
  }

  .zone-promotional-heading {
    margin: 0;
  }
  .zone-promotional-heading-container {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: center;  
  }

  .zone-promotional-label {
    font-family: "SeasonSans-Medium", sans-serif;
    font-weight: 550;
    font-size: 14px;
    line-height: 140%;
    letter-spacing: 12%;
  }

  .zone-promotional-heading {
    font-family: "SeasonMix-Light", sans-serif;
    font-weight: 300;
    font-size: 48px;
    line-height: 90%;
    letter-spacing: 0%;
  }

  .zone-promotional-text {
    font-family: "SeasonSans-Regular", sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 120%;
    letter-spacing: 3%;
  }

  .zone-promotional-heading-container .button-secondary {
    font-size: 10px;
  }

  .zone-promotional-section {
    flex: 0 0 30%;
    display: flex;
  }

  .zone-promotional-image {
    position: relative;
    width: 100%;
    min-height: 680px;
    border-radius: 28px;
    overflow: hidden;
    background-size: cover;
    background-position: center;
  }

  .zone-promotional-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-evenly;
    align-items: center;
    padding: 32px;
    text-align: center;
    background: rgba(255,255,255,0.45);
  }
  .zone-products-section {
    flex: 1;
    min-width: 0;
  }

  .zone-products-scroll-container {
    overflow: visible;
  }

  /* Use theme product-grid; set gap from section settings */
  .zone-products-section .product-grid {
    --product-grid-gap: {{ section.settings.card_spacing }}px;
  }

  @media screen and (min-width: 750px) {
    .zone-products-section .product-grid--zone-collection.product-grid--grid {
      display: grid;
      grid-template-columns: repeat(var(--zone-cards-desktop, 4), 1fr);
    }
  }

  .zone-products-section .product-grid .product-media {
    aspect-ratio: 1;
  }

  .zone-products-section .product-grid .product-media__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Zone product card: old-style layout (title red, price black, wishlist icon) */
  .zone-products-section .grid-product__image-wrap {
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 8px;
    position: relative;
  }

  .zone-products-section .grid__image-contain {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .zone-products-section .grid-product:hover .grid__image-contain {
    transform: scale(1.05);
  }

  .zone-products-section .grid-item__meta {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 8px 0 0;
    gap: 8px;
  }

  .zone-products-section .grid-product__title {
    font-family: var(--font-heading-family), sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 1.2;
    letter-spacing: 0.03em;
    color: var(--color-red);
  }

  .zone-products-section .grid-product__price {
    font-family: var(--font-body-family), sans-serif;
    font-weight: 500;
    font-size: 10px;
    line-height: 1.4;
    color: #000;
  }

  .zone-products-section .grid-product__price--original {
    text-decoration: line-through;
    margin-right: 4px;
    color: #666;
  }

  .zone-products-section .grid-item__meta-main {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 4px;
    min-width: 0;
    flex: 1;
  }

  .zone-products-section .grid-item__meta-secondary {
    flex-shrink: 0;
  }

  .zone-products-section .grid-item__meta-secondary .wishlist-floating-btn button {
    border: none;
    background: transparent;
    padding: 4px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .zone-products-section .grid-item__meta-secondary .wishlist-floating-btn svg.icon-block__media {
    width: 18px;
    height: 18px;
    color: #6B1A2A;
    fill: currentColor;
  }

  .zone-products-section .zone-grid-product .grid-item__link {
    text-decoration: none;
    display: block;
  }

  .zone-products-section .zone-grid-product .grid-item__content {
    border-radius: 0 0 8px 8px;
    padding: 8px 8px 12px;
  }

  .zone-products-section .grid-product__tags,
  .zone-products-section .grid-product__tag {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 1;
  }

  .zone-products-section .grid-product__tag--sold-out,
  .zone-products-section .grid-product__tag--sale {
    font-size: 11px;
    font-weight: 600;
    padding: 4px 8px;
    border-radius: 4px;
  }

  .zone-products-section .grid-product__tag--sold-out {
    background: rgba(0, 0, 0, 0.7);
    color: #fff;
  }

  .zone-products-section .grid-product__tag--sale {
    background: #6B1A2A;
    color: #fff;
  }

  /* Quick add overlay: show on hover, centered pill button */
  .zone-products-section .zone-card-gallery {
    position: relative;
  }

  .zone-products-section .zone-quick-add-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 16px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s ease;
    background: rgba(0, 0, 0, 0.05);
  }

  .zone-products-section .product-grid__item:hover .zone-quick-add-overlay {
    opacity: 1;
    pointer-events: auto;
  }

  .zone-products-section .zone-quick-add-btn {
    pointer-events: auto;
    padding: 12px 24px;
    border: none;
    border-radius: 9999px;
    background: #fff;
    color: #6B1A2A;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.02em;
    cursor: pointer;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.12);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .zone-products-section .zone-quick-add-btn:hover {
    transform: scale(1.02);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
  }

  .zone-products-section .zone-quick-add-btn:disabled {
    cursor: not-allowed;
    opacity: 0.9;
  }

  @media (max-width: 749px) {
    .zone-products-section .zone-quick-add-overlay {
      opacity: 1;
      pointer-events: auto;
      background: rgba(255, 255, 255, 0.85);
    }
    .zone-products-section .zone-quick-add-btn {
      padding: 10px 20px;
      font-size: 13px;
    }
  }

  /* MOBILE */
  @media (max-width: 749px) {
    .zone-collection-layout {
      flex-direction: column;
    }

    .zone-promotional-section {
      flex: 1 1 100%;
    }

    .zone-promotional-image {
      min-height: 480px;
      border-radius: 24px;
    }

    .zone-promotional-heading {
      font-size: 36px;
    }
    .zone-promotional-text {
      font-size: 12px;
      letter-spacing: 4%;
    }

    .zone-products-section .grid-product__title {
      font-size: 14px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Dynamic Zone Collection",
  "tag": "section",
  "class": "section-zone-collection",
  "settings": [
    {
      "type": "header",
      "content": "Promotional Section"
    },
    {
      "type": "checkbox",
      "id": "show_promotional_section",
      "label": "Show promotional section",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "promotional_image",
      "label": "Promotional Image"
    },
    {
      "type": "color",
      "id": "promotional_background_color",
      "label": "Background Color (if no image)",
      "default": "#f5e6e0"
    },
    {
      "type": "text",
      "id": "promotional_label",
      "label": "Label Text",
      "default": "COLLECTION"
    },
    {
      "type": "text",
      "id": "promotional_heading",
      "label": "Heading Text",
      "default": "Curated for You"
    },
    {
      "type": "richtext",
      "id": "promotional_text",
      "label": "Description Text",
      "default": "<p>Based on your location in Zone {zone}, these could be great for your garden.</p>",
      "info": "Use {zone} where the zone number should appear (e.g. Zone 6). It updates automatically from the visitor's saved zone."
    },
    {
      "type": "text",
      "id": "promotional_button_text",
      "label": "Button Text",
      "default": "VIEW ALL"
    },
    {
      "type": "checkbox",
      "id": "show_promotional_icon",
      "label": "Show decorative icon",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "products_limit",
      "label": "Number of Products",
      "options": [
        { "value": "4", "label": "4" },
        { "value": "6", "label": "6" }
      ],
      "default": "6"
    },
    {
      "type": "range",
      "id": "cards_desktop",
      "min": 3,
      "max": 6,
      "step": 1,
      "label": "Cards visible desktop",
      "default": 4
    },
    {
      "type": "select",
      "id": "cards_mobile",
      "label": "Cards visible mobile",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "card_spacing",
      "min": 10,
      "max": 40,
      "step": 5,
      "unit": "px",
      "label": "Card spacing",
      "default": 20
    },
    {
      "type": "header",
      "content": "Section style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Theme colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "use_theme_colors",
      "label": "Use theme color scheme for button and text",
      "info": "When off, use custom colors below",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Dynamic Zone Collection"
    }
  ]
}
{% endschema %}
{% comment %}
  position: relative;
  width: 100%;
  margin-bottom: 12px;
  aspect-ratio: 1;
  overflow: hidden;
  border-radius: 8px;
  background-color: #f5f5f5;
{% endcomment %}
