{% liquid
  assign color_blocks = section.blocks | where: 'type', 'color_item'
  assign block_count = color_blocks.size
  assign layout_mode = section.settings.layout_mode
  assign columns_desktop = section.settings.columns_desktop
  assign columns_mobile = section.settings.columns_mobile
  assign show_arrows = false
  if layout_mode == 'carousel' and section.settings.icons_style != 'none' and block_count > 1
    assign show_arrows = true
  endif
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="
    section
    section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    shop-by-color
    spacing-style
    gap-style
    shop-by-color--{{ layout_mode }}
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% render 'gap-style', value: section.settings.gap %}
    --shop-by-color-column-gap: {{ section.settings.column_gap }}px;
    --shop-by-color-row-gap: {{ section.settings.row_gap }}px;
    --shop-by-color-columns-desktop: {{ columns_desktop }};
    --shop-by-color-columns-mobile: {{ columns_mobile }};
  "
  data-testid="shop-by-color"
>
  <div class="shop-by-color__inner">
    {% if section.settings.heading != blank %}
      <h2 class="shop-by-color__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if block_count > 0 %}
      {% if layout_mode == 'carousel' %}
        {% capture color_slides %}
          {% for block in color_blocks %}
            {% capture slide_content %}
              <div class="shop-by-color__item" {{ block.shopify_attributes }}>
                {% if block.settings.link != blank %}
                  <a href="{{ block.settings.link }}" class="shop-by-color__link">
                {% endif %}
                <div class="shop-by-color__image-wrap">
                  {% if block.settings.image != blank %}
                    {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', alt: block.settings.title | default: block.settings.image.alt, class: 'shop-by-color__image' }}
                  {% else %}
                    <div class="shop-by-color__placeholder">{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}</div>
                  {% endif %}
                </div>
                {% if block.settings.title != blank %}
                  <span class="shop-by-color__label">{{ block.settings.title }}</span>
                {% endif %}
                {% if block.settings.link != blank %}
                  </a>
                {% endif %}
              </div>
            {% endcapture %}
            {% render 'slideshow-slide', index: forloop.index0, children: slide_content, class: 'shop-by-color__slide' %}
          {% endfor %}
        {% endcapture %}

        <div
          class="shop-by-color__carousel resource-list__carousel"
          style="--slide-width-max: 180px;{% if section.settings.section_width == 'page-width' %} --gutter-slide-width: var(--util-page-margin-offset);{% else %} --gutter-slide-width: 0px;{% endif %}"
        >
          {% liquid
            assign carousel_gutters = null
            if section.settings.section_width == 'page-width'
              assign carousel_gutters = 'start end'
            endif
          %}
          {% render 'slideshow',
            ref: 'shopByColor',
            class: 'shop-by-color__slideshow',
            slides: color_slides,
            show_arrows: show_arrows,
            icon_style: section.settings.icons_style,
            icon_shape: section.settings.icons_shape,
            auto_hide_controls: false,
            infinite: false,
            initial_slide: 0,
            slide_count: block_count,
            slideshow_gutters: carousel_gutters
          %}
        </div>
      {% else %}
        <div class="shop-by-color__grid">
          {% for block in color_blocks %}
            <div class="shop-by-color__item" {{ block.shopify_attributes }}>
              {% if block.settings.link != blank %}
                <a href="{{ block.settings.link }}" class="shop-by-color__link">
              {% endif %}
              <div class="shop-by-color__image-wrap">
                {% if block.settings.image != blank %}
                  {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', alt: block.settings.title | default: block.settings.image.alt, class: 'shop-by-color__image' }}
                {% else %}
                  <div class="shop-by-color__placeholder">{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}</div>
                {% endif %}
              </div>
              {% if block.settings.title != blank %}
                <span class="shop-by-color__label">{{ block.settings.title }}</span>
              {% endif %}
              {% if block.settings.link != blank %}
                </a>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      {% endif %}
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .shop-by-color-section {
    padding: 8px 16px;
  }
  .shop-by-color-section .section {
    padding: 64px 64px 120px 64px;
  }
  @media screen and (max-width: 749px) {
    .shop-by-color-section .section {
      padding: 16px;
    } 
  }
  .shop-by-color__inner {
    display: flex;
    flex-direction: column;
    gap: var(--gap, 64px);
  }

  .shop-by-color__inner h2 {
    font-family: "SeasonMix-Light", sans-serif;
    font-weight: 300;
    font-size: 64px;
    line-height: 90%;
    letter-spacing: 0%;
  }

  @media screen and (max-width: 749px) {
    .shop-by-color__inner h2 {
      font-size: 36px;
    } 
  }

  .shop-by-color__heading {
    margin: 0;
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 600;
    color: rgb(var(--color-foreground));
    line-height: 1.2;
  }

  .shop-by-color__grid {
    display: grid;
    grid-auto-flow: row;
    grid-template-columns: repeat(var(--shop-by-color-columns-mobile), 1fr);
    gap: var(--shop-by-color-row-gap) var(--shop-by-color-column-gap);
  }

  @media screen and (min-width: 750px) {
    .shop-by-color__grid {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      gap: var(--shop-by-color-row-gap) var(--shop-by-color-column-gap);
    }

    .shop-by-color__grid .shop-by-color__item {
      /* flex: 0 0 calc(100% / var(--shop-by-color-columns-desktop)); */
      flex: 1 0 auto;
      max-width: 100%;
    }
  }

  @media screen and (max-width: 749px) {
    .shop-by-color__grid {
      column-gap: 32px;
    }
  }

  .shop-by-color__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .shop-by-color__link {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    color: inherit;
  }

  .shop-by-color__link:hover .shop-by-color__label {
    text-decoration: underline;
  }

  .shop-by-color__image-wrap {
    position: relative;
    width: 118px;
    height: 118px;
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    margin-bottom: 0;
    flex-shrink: 0;
    border: 2px solid var(--color-brown);
  }
  @media screen and (max-width: 749px) {
    .shop-by-color__image-wrap {
      width: 22.637vw;
      aspect-ratio: 1/1;
      height: auto;
      border: 1px solid var(--color-brown);
    }
  }

  .shop-by-color__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .shop-by-color__placeholder {
    width: 100%;
    height: 100%;
    background: rgb(var(--color-foreground) / 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .shop-by-color__placeholder .placeholder-svg {
    width: 50%;
    height: 50%;
    opacity: 0.3;
  }

  .shop-by-color__label {
    color: rgb(var(--color-foreground));
    font-family: "SeasonSans-Light", sans-serif;
    font-weight: 300;
    font-size: 24px;
    line-height: 120%;
    letter-spacing: 2%;
    padding: 8px;
  }
  @media screen and (max-width: 749px) {
    .shop-by-color__label {
      font-size: 16px;
      letter-spacing: 3%;
    }
  }

  /* Carousel layout */
  .shop-by-color--carousel .shop-by-color__carousel {
    width: 100%;
  }

  .shop-by-color__slideshow slideshow-slide {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .shop-by-color__slide .shop-by-color__item {
    width: 100%;
    max-width: 180px;
  }

  .shop-by-color__slide .shop-by-color__image-wrap {
    max-width: 180px;
    margin-inline: auto;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Shop by Color",
  "class": "shop-by-color-section",
  "tag": "section",
  "max_blocks": 20,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Color"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_mode",
      "label": "Display",
      "options": [
        {
          "value": "grid",
          "label": "Grid (fixed)"
        },
        {
          "value": "carousel",
          "label": "Carousel (scroll)"
        }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 9,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns (mobile)",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }
      ],
      "default": "3"
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Gap between columns",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "Gap between rows",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.layout_mode == 'grid' }}"
    },
    {
      "type": "header",
      "content": "Carousel navigation",
      "visible_if": "{{ section.settings.layout_mode == 'carousel' }}"
    },
    {
      "type": "select",
      "id": "icons_style",
      "label": "Arrow style",
      "options": [
        { "value": "arrow", "label": "Arrows" },
        { "value": "chevron", "label": "Chevrons" },
        { "value": "arrows_large", "label": "Large arrows" },
        { "value": "chevron_large", "label": "Large chevrons" },
        { "value": "none", "label": "None" }
      ],
      "default": "arrow",
      "visible_if": "{{ section.settings.layout_mode == 'carousel' }}"
    },
    {
      "type": "select",
      "id": "icons_shape",
      "label": "Arrow background",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "circle", "label": "Circle" },
        { "value": "square", "label": "Square" }
      ],
      "default": "none",
      "visible_if": "{{ section.settings.layout_mode == 'carousel' and section.settings.icons_style != 'none' }}"
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap below heading",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "color_item",
      "name": "Color",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Color name",
          "default": "Color"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Color",
      "category": "Collections",
      "settings": {
        "heading": "Shop by Color",
        "layout_mode": "grid",
        "columns_desktop": 9,
        "columns_mobile": "3",
        "column_gap": 24,
        "row_gap": 24,
        "padding-block-start": 48,
        "padding-block-end": 48
      },
      "blocks": [
        { "type": "color_item", "settings": { "title": "Purple" } },
        { "type": "color_item", "settings": { "title": "Pink" } },
        { "type": "color_item", "settings": { "title": "Red" } },
        { "type": "color_item", "settings": { "title": "Orange" } },
        { "type": "color_item", "settings": { "title": "Apricot" } },
        { "type": "color_item", "settings": { "title": "Multi" } },
        { "type": "color_item", "settings": { "title": "Yellow" } },
        { "type": "color_item", "settings": { "title": "Neutral" } },
        { "type": "color_item", "settings": { "title": "White" } }
      ]
    }
  ]
}
{% endschema %}
