{{ 'employee.css' | asset_url | stylesheet_tag }}
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js" defer="defer"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js" defer="defer"></script>
<script src="{{ 'employee.js' | asset_url }}" defer="defer"></script>

<div class="employee-page">
  {% if section.blocks.size > 0 %}
    <div class="template-selection">
      <h3>{{ section.settings.template_selection_title }}</h3>
      <div class="template-options">
        {% for block in section.blocks %}
          {% if block.type == 'template' %}
            <div class="template-option" {{ block.shopify_attributes }}>
              <input 
                type="radio" 
                id="template-{{ forloop.index }}" 
                name="template" 
                value="{{ block.id }}"
                data-image="{{ block.settings.template_image | image_url }}"
                data-text-top="{{ block.settings.text_position_top | default: '70.5%' }}"
                data-text-left="{{ block.settings.text_position_left | default: '50%' }}"
                data-font-size="{{ block.settings.text_font_size | default: '40px' }}"
                data-text-color="{{ block.settings.text_color | default: 'rgb(83, 194, 149)' }}"
                {% if forloop.first %}checked{% endif %}
              >
              <label for="template-{{ forloop.index }}">
                {{ block.settings.template_name }}
              </label>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  {% endif %}

  <div class="form-feild">
    <input type="text" id="nameInput" placeholder="{{ section.settings.employee_placeholder }}">
    <button onclick="downloadPNG()">{{ section.settings.employee_png }}</button>
    <button onclick="downloadPDF()">{{ section.settings.employee_pdf }}</button>
  </div>

  <div id="editor" class="scaled-preview">
    <img
      id="eidImage"
      crossorigin="anonymous"
      src="{% if section.blocks.first.settings.template_image %}{{ section.blocks.first.settings.template_image | image_url }}{% else %}{{ 'placeholder.png' | asset_url }}{% endif %}"
      alt="Employee Card Template"
      height="auto"
      width="auto"
    >
    <div id="textOverlay"></div>
  </div>
</div>

{% schema %}
{
  "name": "Employee Card",
  "settings": [
    {
      "type": "text",
      "id": "template_selection_title",
      "label": "Template Selection Title",
      "default": "Choose Template"
    },
    {
      "type": "text",
      "id": "employee_placeholder",
      "label": "Name input placeholder",
      "default": "Enter Name"
    },
    {
      "type": "text",
      "id": "employee_png",
      "label": "Download PNG Button Label",
      "default": "Download PNG"
    },
    {
      "type": "text",
      "id": "employee_pdf",
      "label": "Download PDF Button Label",
      "default": "Download PDF"
    }
  ],
  "blocks": [
    {
      "type": "template",
      "name": "Card Template",
      "settings": [
        {
          "type": "text",
          "id": "template_name",
          "label": "Template Name",
          "default": "Template 1",
          "info": "This will be shown as the radio button label"
        },
        {
          "type": "image_picker",
          "id": "template_image",
          "label": "Template Background Image"
        },
        {
          "type": "text",
          "id": "text_position_top",
          "label": "Text Position Top",
          "default": "70.5%",
          "info": "CSS position from top (e.g., 70.5%, 38%, etc.)"
        },
        {
          "type": "text",
          "id": "text_position_left",
          "label": "Text Position Left",
          "default": "50%",
          "info": "CSS position from left (e.g., 50%, 60%, etc.)"
        },
        {
          "type": "text",
          "id": "text_font_size",
          "label": "Text Font Size",
          "default": "40px",
          "info": "Font size for the name text (e.g., 40px, 2rem, etc.)"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text Color",
          "default": "#53c29a",
          "info": "Color of the name text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Employee Card",
      "category": "Custom",
      "blocks": [
        {
          "type": "template",
          "settings": {
            "template_name": "Default Template"
          }
        }
      ]
    }
  ]
}
{% endschema %}