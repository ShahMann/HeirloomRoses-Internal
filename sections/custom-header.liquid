{% comment %}
  Custom Header - Standalone 3-column header
  Left: Mega Menu (SHOP) + Flower Match Maker pill button
  Center: Logo (flower icon + HEIRLOOM or image)
  Right: LEARN dropdown + ABOUT dropdown + Search
{% endcomment %}

{% liquid
  assign menu_learn = section.settings.menu_learn
  assign menu_about = section.settings.menu_about
  assign mega_trigger_label = section.settings.mega_menu_trigger_label | default: 'SHOP'
  assign mega_columns_count = section.settings.mega_menu_columns_count | default: 4
  assign mega_panel_align = section.settings.mega_menu_panel_align | default: 'page-width'
  assign mega_image = section.settings.mega_menu_image
  assign mega_image_position = section.settings.mega_menu_image_position | default: 'first'
  assign mega_columns = section.blocks | where: 'type', 'mega_menu_column'
  assign has_mega_content = false
  if mega_columns.size > 0 or mega_image != blank
    assign has_mega_content = true
  endif
%}

<header
  class="custom-header section section--{{ section.settings.section_width }}"
  role="banner"
  style="
    --custom-header-bg: {{ section.settings.background_color }};
    --custom-header-text: {{ section.settings.text_color }};
    --custom-header-logo-height: {{ section.settings.logo_height }}px;
    --custom-header-mega-bg: {{ section.settings.mega_menu_bg_color | default: '#fdfcfc' }};
  "
>
  <div class="custom-header__container">
    {% comment %} Left: Mega Menu trigger + Flower Match Maker {% endcomment %}
    <div class="custom-header__column custom-header__column--left">
      <nav class="custom-header__nav custom-header__nav--left" aria-label="{{ 'accessibility.header_navigation_label' | t | default: 'Header navigation' }}">
        {% if has_mega_content %}
          <div class="custom-header__mega-wrap">
            <details class="custom-header__details custom-header__details--mega" data-mega-menu>
              <summary class="custom-header__summary" aria-expanded="false" aria-haspopup="true">
                <span class="custom-header__label">{{ mega_trigger_label }}</span>
                <span class="custom-header__caret svg-wrapper icon-caret">
                  {{ 'icon-caret.svg' | inline_asset_content }}
                </span>
              </summary>
              <div class="custom-header__mega-panel" data-mega-panel>
                <div class="custom-header__mega-inner custom-header__mega-inner--{{ mega_panel_align }}">
                  {% if mega_image != blank and mega_image_position == 'first' %}
                    <div class="custom-header__mega-image custom-header__mega-image--first">
                      {% if section.settings.mega_menu_image_link != blank %}
                        <a href="{{ section.settings.mega_menu_image_link }}" class="custom-header__mega-image-link">
                      {% endif %}
                      <div class="custom-header__mega-image-inner">
                        <img
                          src="{{ mega_image | image_url: width: 400 }}"
                          alt="{{ section.settings.mega_menu_image_title | default: '' }}"
                          width="240"
                          height="320"
                          loading="lazy"
                          class="custom-header__mega-image-img"
                        >
                        <div class="custom-header__mega-image-overlay">
                          {% if section.settings.mega_menu_image_title != blank %}
                            <span class="custom-header__mega-image-title">{{ section.settings.mega_menu_image_title }}</span>
                          {% endif %}
                          {% if section.settings.mega_menu_image_subtitle != blank %}
                            <span class="custom-header__mega-image-subtitle">{{ section.settings.mega_menu_image_subtitle }}</span>
                          {% endif %}
                          <span class="custom-header__mega-image-arrow" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                          </span>
                        </div>
                      </div>
                      {% if section.settings.mega_menu_image_link != blank %}
                        </a>
                      {% endif %}
                    </div>
                  {% endif %}

                  <div class="custom-header__mega-columns">
                    {% for block in mega_columns limit: mega_columns_count %}
                      <div class="custom-header__mega-column" {{ block.shopify_attributes }}>
                        {% if block.settings.heading != blank %}
                          <p class="custom-header__mega-column-heading">{{ block.settings.heading }}</p>
                        {% endif %}
                        {% if block.settings.menu.links.size > 0 %}
                          <ul class="custom-header__mega-column-list list-unstyled" role="list">
                            {% for link in block.settings.menu.links limit: 6 %}
                              <li>
                                <a href="{{ link.url }}" class="custom-header__mega-column-link{% if link.active %} custom-header__mega-column-link--active{% endif %}">{{ link.title }}</a>
                              </li>
                            {% endfor %}
                          </ul>
                        {% endif %}
                      </div>
                    {% endfor %}
                  </div>

                  {% if mega_image != blank and mega_image_position == 'last' %}
                    <div class="custom-header__mega-image custom-header__mega-image--last">
                      {% if section.settings.mega_menu_image_link != blank %}
                        <a href="{{ section.settings.mega_menu_image_link }}" class="custom-header__mega-image-link">
                      {% endif %}
                      <div class="custom-header__mega-image-inner">
                        <img
                          src="{{ mega_image | image_url: width: 400 }}"
                          alt="{{ section.settings.mega_menu_image_title | default: '' }}"
                          width="240"
                          height="320"
                          loading="lazy"
                          class="custom-header__mega-image-img"
                        >
                        <div class="custom-header__mega-image-overlay">
                          {% if section.settings.mega_menu_image_title != blank %}
                            <span class="custom-header__mega-image-title">{{ section.settings.mega_menu_image_title }}</span>
                          {% endif %}
                          {% if section.settings.mega_menu_image_subtitle != blank %}
                            <span class="custom-header__mega-image-subtitle">{{ section.settings.mega_menu_image_subtitle }}</span>
                          {% endif %}
                          <span class="custom-header__mega-image-arrow" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                          </span>
                        </div>
                      </div>
                      {% if section.settings.mega_menu_image_link != blank %}
                        </a>
                      {% endif %}
                    </div>
                  {% endif %}
                </div>
              </div>
            </details>
          </div>
        {% endif %}

        {% if section.settings.show_flower_match_maker and section.settings.flower_match_maker_url != blank %}
          <a
            href="{{ section.settings.flower_match_maker_url }}"
            class="custom-header__pill custom-header__pill--flower"
          >
            <span class="custom-header__pill-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2c-.96 0-1.88.23-2.72.64C7.82 3.5 7 4.95 7 6.5c0 1.36.58 2.58 1.5 3.44L12 14l3.5-4.06C16.42 9.08 17 7.86 17 6.5c0-1.55-.82-3-2.28-3.86C13.88 2.23 12.96 2 12 2zm0 12l-2.5 2.9C8.5 18.5 7 21 7 24h10c0-3-1.5-5.5-2.5-7.1L12 14z"/>
              </svg>
            </span>
            <span>{{ section.settings.flower_match_maker_text | default: 'FLOWER MATCH MAKER' }}</span>
          </a>
        {% endif %}
      </nav>
    </div>

    {% comment %} Center: Logo {% endcomment %}
    <div class="custom-header__column custom-header__column--center">
      <a href="{{ routes.root_url }}" class="custom-header__logo" aria-label="{{ shop.name }}">
        {% if section.settings.logo_image != blank %}
          <img
            src="{{ section.settings.logo_image | image_url: width: 400 }}"
            alt="{{ section.settings.logo_text | default: shop.name }}"
            class="custom-header__logo-image"
            width="{{ section.settings.logo_image.width }}"
            height="{{ section.settings.logo_image.height }}"
            loading="eager"
          >
        {% else %}
          {% if section.settings.show_logo_flower_icon %}
            <span class="custom-header__logo-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2c-.96 0-1.88.23-2.72.64C7.82 3.5 7 4.95 7 6.5c0 1.36.58 2.58 1.5 3.44L12 14l3.5-4.06C16.42 9.08 17 7.86 17 6.5c0-1.55-.82-3-2.28-3.86C13.88 2.23 12.96 2 12 2zm0 12l-2.5 2.9C8.5 18.5 7 21 7 24h10c0-3-1.5-5.5-2.5-7.1L12 14z"/>
              </svg>
            </span>
          {% endif %}
          <span class="custom-header__logo-text">{{ section.settings.logo_text | default: 'HEIRLOOM' }}</span>
        {% endif %}
      </a>
    </div>

    {% comment %} Right: LEARN + ABOUT + Search {% endcomment %}
    <div class="custom-header__column custom-header__column--right">
      <nav class="custom-header__nav custom-header__nav--right" aria-label="{{ 'accessibility.header_navigation_label' | t | default: 'Header navigation' }}">
        {% if menu_learn.links.size > 0 %}
          <div class="custom-header__dropdown">
            <details class="custom-header__details">
              <summary class="custom-header__summary" aria-expanded="false" aria-haspopup="true">
                <span class="custom-header__label">{{ menu_learn.title | default: 'LEARN' }}</span>
                <span class="custom-header__caret svg-wrapper icon-caret">
                  {{ 'icon-caret.svg' | inline_asset_content }}
                </span>
              </summary>
              <div class="custom-header__dropdown-panel">
                <ul class="custom-header__dropdown-list list-unstyled" role="list">
                  {% for link in menu_learn.links %}
                    <li>
                      <a href="{{ link.url }}" class="custom-header__dropdown-link{% if link.active %} custom-header__dropdown-link--active{% endif %}">{{ link.title }}</a>
                      {% if link.links.size > 0 %}
                        <ul class="custom-header__dropdown-sublist list-unstyled" role="list">
                          {% for child in link.links %}
                            <li><a href="{{ child.url }}" class="custom-header__dropdown-link custom-header__dropdown-link--child">{{ child.title }}</a></li>
                          {% endfor %}
                        </ul>
                      {% endif %}
                    </li>
                  {% endfor %}
                </ul>
              </div>
            </details>
          </div>
        {% endif %}

        {% if menu_about.links.size > 0 %}
          <div class="custom-header__dropdown">
            <details class="custom-header__details">
              <summary class="custom-header__summary" aria-expanded="false" aria-haspopup="true">
                <span class="custom-header__label">{{ menu_about.title | default: 'ABOUT' }}</span>
                <span class="custom-header__caret svg-wrapper icon-caret">
                  {{ 'icon-caret.svg' | inline_asset_content }}
                </span>
              </summary>
              <div class="custom-header__dropdown-panel">
                <ul class="custom-header__dropdown-list list-unstyled" role="list">
                  {% for link in menu_about.links %}
                    <li>
                      <a href="{{ link.url }}" class="custom-header__dropdown-link{% if link.active %} custom-header__dropdown-link--active{% endif %}">{{ link.title }}</a>
                      {% if link.links.size > 0 %}
                        <ul class="custom-header__dropdown-sublist list-unstyled" role="list">
                          {% for child in link.links %}
                            <li><a href="{{ child.url }}" class="custom-header__dropdown-link custom-header__dropdown-link--child">{{ child.title }}</a></li>
                          {% endfor %}
                        </ul>
                      {% endif %}
                    </li>
                  {% endfor %}
                </ul>
              </div>
            </details>
          </div>
        {% endif %}

        {% if section.settings.show_search %}
          <div class="custom-header__search">
            {% render 'search', style: 'modal', display_style: 'icon' %}
          </div>
        {% endif %}
      </nav>
    </div>

    {% comment %} Mobile: Hamburger toggle {% endcomment %}
    <button
      type="button"
      class="custom-header__hamburger"
      aria-label="{{ 'accessibility.menu' | t | default: 'Open menu' }}"
      aria-expanded="false"
      aria-controls="custom-header-mobile-drawer-{{ section.id }}"
      data-mobile-toggle
    >
      <span class="custom-header__hamburger-icon custom-header__hamburger-icon--open">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </span>
      <span class="custom-header__hamburger-icon custom-header__hamburger-icon--close" hidden>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </span>
    </button>
  </div>

  {% comment %} Mobile drawer {% endcomment %}
  <div
    id="custom-header-mobile-drawer-{{ section.id }}"
    class="custom-header__drawer"
    hidden
    data-mobile-drawer
  >
    <div class="custom-header__drawer-inner">
      {% if has_mega_content %}
        <div class="custom-header__drawer-block custom-header__drawer-mega">
          <span class="custom-header__drawer-title">{{ mega_trigger_label }}</span>
          {% if mega_image != blank and section.settings.mega_menu_image_link != blank %}
            <a href="{{ section.settings.mega_menu_image_link }}" class="custom-header__drawer-mega-image-link">
              <img src="{{ mega_image | image_url: width: 300 }}" alt="" class="custom-header__drawer-mega-image" loading="lazy" width="300" height="200">
              {% if section.settings.mega_menu_image_title != blank %}
                <span class="custom-header__drawer-mega-image-title">{{ section.settings.mega_menu_image_title }}</span>
              {% endif %}
            </a>
          {% endif %}
          {% for block in mega_columns limit: mega_columns_count %}
            <div class="custom-header__drawer-mega-column">
              {% if block.settings.heading != blank %}
                <span class="custom-header__drawer-mega-heading">{{ block.settings.heading }}</span>
              {% endif %}
              {% if block.settings.menu.links.size > 0 %}
                <ul class="list-unstyled" role="list">
                  {% for link in block.settings.menu.links %}
                    <li><a href="{{ link.url }}" class="custom-header__drawer-link">{{ link.title }}</a></li>
                  {% endfor %}
                </ul>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      {% endif %}
      {% if section.settings.show_flower_match_maker and section.settings.flower_match_maker_url != blank %}
        <a href="{{ section.settings.flower_match_maker_url }}" class="custom-header__pill custom-header__pill--flower custom-header__drawer-pill">
          <span class="custom-header__pill-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2c-.96 0-1.88.23-2.72.64C7.82 3.5 7 4.95 7 6.5c0 1.36.58 2.58 1.5 3.44L12 14l3.5-4.06C16.42 9.08 17 7.86 17 6.5c0-1.55-.82-3-2.28-3.86C13.88 2.23 12.96 2 12 2zm0 12l-2.5 2.9C8.5 18.5 7 21 7 24h10c0-3-1.5-5.5-2.5-7.1L12 14z"/></svg>
          </span>
          {{ section.settings.flower_match_maker_text | default: 'FLOWER MATCH MAKER' }}
        </a>
      {% endif %}
      {% if menu_learn.links.size > 0 %}
        <div class="custom-header__drawer-block">
          <span class="custom-header__drawer-title">{{ menu_learn.title | default: 'LEARN' }}</span>
          <ul class="list-unstyled" role="list">
            {% for link in menu_learn.links %}
              <li><a href="{{ link.url }}" class="custom-header__drawer-link">{{ link.title }}</a></li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}
      {% if menu_about.links.size > 0 %}
        <div class="custom-header__drawer-block">
          <span class="custom-header__drawer-title">{{ menu_about.title | default: 'ABOUT' }}</span>
          <ul class="list-unstyled" role="list">
            {% for link in menu_about.links %}
              <li><a href="{{ link.url }}" class="custom-header__drawer-link">{{ link.title }}</a></li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}
      {% if section.settings.show_search %}
        <div class="custom-header__drawer-search">
          {% render 'search', style: 'modal', display_style: 'icon' %}
        </div>
      {% endif %}
    </div>
  </div>
</header>

<script>
  (function() {
    const sectionId = '{{ section.id }}';
    const header = document.querySelector('.custom-header');
    if (!header) return;

    const toggle = header.querySelector('[data-mobile-toggle]');
    const drawer = header.querySelector('[data-mobile-drawer]');
    if (!toggle || !drawer) return;

    toggle.addEventListener('click', function() {
      const open = drawer.hidden;
      drawer.hidden = !open;
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      toggle.querySelector('.custom-header__hamburger-icon--open').hidden = open;
      toggle.querySelector('.custom-header__hamburger-icon--close').hidden = !open;
      document.body.style.overflow = open ? 'hidden' : '';
    });

    header.querySelectorAll('.custom-header__details').forEach(function(details) {
      const summary = details.querySelector('.custom-header__summary');
      if (!summary) return;
      details.addEventListener('toggle', function() {
        summary.setAttribute('aria-expanded', details.open);
      });
      summary.setAttribute('aria-expanded', details.open);
    });
  })();
</script>

{% stylesheet %}
  .custom-header {
    background-color: var(--custom-header-bg);
    color: var(--custom-header-text);
    border-bottom: 1px solid rgba(107, 26, 42, 0.12);
  }

  .custom-header__container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-md);
    padding: var(--padding-sm) var(--padding-lg);
    position: relative;
    min-height: 60px;
  }

  .custom-header__column {
    display: flex;
    align-items: center;
    flex: 1;
    min-width: 0;
  }

  .custom-header__column--left {
    justify-content: flex-start;
  }

  .custom-header__column--center {
    justify-content: center;
  }

  .custom-header__column--right {
    justify-content: flex-end;
  }

  .custom-header__nav {
    display: flex;
    align-items: center;
    gap: var(--gap-lg);
  }

  .custom-header__nav--right {
    gap: var(--gap-md);
  }

  .custom-header__summary,
  .custom-header__dropdown-link,
  .custom-header__pill {
    color: var(--custom-header-text);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.9375rem;
    letter-spacing: 0.02em;
  }

  .custom-header__summary {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    cursor: pointer;
    background: none;
    border: none;
    padding: 0.25rem 0;
    font-family: inherit;
    list-style: none;
  }

  .custom-header__summary::-webkit-details-marker { display: none; }

  .custom-header__caret {
    width: 12px;
    height: 12px;
    transition: transform 0.2s ease;
  }

  .custom-header__details[open] .custom-header__caret svg {
    transform: rotate(180deg);
  }

  .custom-header__dropdown {
    position: relative;
  }

  /* Mega menu */
  .custom-header__mega-wrap {
    position: static;
  }

  .custom-header__details--mega {
    position: relative;
  }

  .custom-header__mega-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    margin-top: 0;
    background: var(--custom-header-mega-bg, #fdfcfc);
    border-bottom: 1px solid rgba(107, 26, 42, 0.1);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
    z-index: var(--layer-raised);
    padding: var(--padding-xl) 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition: opacity 0.25s ease, visibility 0.25s ease, transform 0.25s ease;
  }

  .custom-header__details--mega[open] .custom-header__mega-panel {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .custom-header__mega-inner {
    display: flex;
    align-items: flex-start;
    gap: var(--padding-xl);
    margin: 0 auto;
    padding: 0 var(--padding-lg);
  }

  .custom-header__mega-inner--full-width {
    max-width: none;
    padding-inline: var(--page-margin, 2rem);
  }

  .custom-header__mega-inner--page-width {
    max-width: var(--page-width);
    width: 100%;
  }

  .custom-header__mega-inner--center {
    max-width: var(--page-width);
    width: 100%;
    justify-content: center;
  }

  .custom-header__mega-columns {
    display: flex;
    flex-wrap: wrap;
    gap: var(--padding-xl);
    flex: 1;
    min-width: 0;
  }

  .custom-header__mega-column {
    min-width: 140px;
    flex: 0 0 auto;
  }

  .custom-header__mega-column-heading {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--custom-header-text);
    opacity: 0.65;
    margin: 0 0 0.75rem 0;
  }

  .custom-header__mega-column-list {
    margin: 0;
    padding: 0;
  }

  .custom-header__mega-column-list li {
    margin: 0;
  }

  .custom-header__mega-column-link {
    display: block;
    padding: 0.35rem 0;
    font-size: 1rem;
    font-weight: 500;
    color: var(--custom-header-text);
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .custom-header__mega-column-link:hover,
  .custom-header__mega-column-link--active {
    opacity: 0.85;
  }

  .custom-header__mega-image {
    flex-shrink: 0;
    width: 220px;
  }

  .custom-header__mega-image-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .custom-header__mega-image-inner {
    position: relative;
    border-radius: var(--style-border-radius-popover, 12px);
    overflow: hidden;
    aspect-ratio: 3 / 4;
    background: rgba(107, 26, 42, 0.06);
  }

  .custom-header__mega-image-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .custom-header__mega-image-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1rem;
    background: linear-gradient(to top, rgba(0,0,0,0.4) 0%, transparent 50%);
    color: #fff;
  }

  .custom-header__mega-image-title {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
  }

  .custom-header__mega-image-subtitle {
    font-size: 0.875rem;
    opacity: 0.9;
  }

  .custom-header__mega-image-arrow {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    opacity: 0.9;
  }

  .custom-header__dropdown-panel {
    position: absolute;
    top: 100%;
    left: 0;
    margin-top: 4px;
    min-width: 200px;
    background: var(--custom-header-bg);
    border: 1px solid rgba(107, 26, 42, 0.15);
    border-radius: var(--style-border-radius-popover, 8px);
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    z-index: var(--layer-raised);
    padding: var(--padding-xs) 0;
  }

  .custom-header__dropdown-list {
    margin: 0;
    padding: 0;
  }

  .custom-header__dropdown-list > li {
    margin: 0;
  }

  .custom-header__dropdown-link {
    display: block;
    padding: 0.5rem 1rem;
    transition: background 0.15s ease;
  }

  .custom-header__dropdown-link:hover,
  .custom-header__dropdown-link--active {
    background: rgba(107, 26, 42, 0.06);
  }

  .custom-header__dropdown-sublist {
    margin: 0;
    padding-left: 1rem;
    border-left: 1px solid rgba(107, 26, 42, 0.1);
  }

  .custom-header__dropdown-link--child {
    font-size: 0.875rem;
  }

  .custom-header__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border: 2px solid var(--custom-header-text);
    border-radius: 9999px;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .custom-header__pill:hover {
    background: var(--custom-header-text);
    color: var(--custom-header-bg);
  }

  .custom-header__pill-icon {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .custom-header__logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--custom-header-text);
    font-weight: 600;
    font-size: 1.5rem;
    letter-spacing: 0.02em;
  }

  .custom-header__logo-image {
    height: var(--custom-header-logo-height);
    width: auto;
    object-fit: contain;
  }

  .custom-header__logo-icon {
    display: flex;
  }

  .custom-header__logo-text {
    font-family: var(--font-heading--family);
  }

  .custom-header__search {
    display: flex;
    align-items: center;
  }

  .custom-header__search .search-action button,
  .custom-header__search .header-actions__action {
    color: var(--custom-header-text);
    padding: 0.25rem;
  }

  .custom-header__search .svg-wrapper {
    width: 22px;
    height: 22px;
  }

  .custom-header__hamburger {
    display: none;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    background: none;
    border: none;
    color: var(--custom-header-text);
    cursor: pointer;
  }

  .custom-header__drawer {
    display: none;
    position: fixed;
    inset: 0;
    top: 60px;
    z-index: var(--layer-overlay);
    background: var(--custom-header-bg);
    overflow-y: auto;
    padding: var(--padding-lg);
  }

  .custom-header__drawer-inner {
    display: flex;
    flex-direction: column;
    gap: var(--gap-lg);
  }

  .custom-header__drawer-title {
    font-weight: 600;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--custom-header-text);
    opacity: 0.85;
    display: block;
    margin-bottom: 0.5rem;
  }

  .custom-header__drawer-link {
    display: block;
    padding: 0.5rem 0;
    color: var(--custom-header-text);
    text-decoration: none;
    font-size: 1rem;
  }

  .custom-header__drawer-sublink .custom-header__drawer-link {
    padding-left: 1rem;
    font-size: 0.9375rem;
  }

  .custom-header__drawer-pill {
    margin-top: 0.5rem;
    width: fit-content;
  }

  .custom-header__drawer-search {
    margin-top: 0.5rem;
  }

  @media screen and (max-width: 749px) {
    .custom-header__nav--left,
    .custom-header__nav--right {
      display: none;
    }

    .custom-header__hamburger {
      display: flex;
    }

    .custom-header__column--left {
      flex: 0;
    }

    .custom-header__column--right {
      flex: 0;
    }

    .custom-header__drawer:not([hidden]) {
      display: block;
    }
  }

  @media screen and (max-width: 749px) {
    .custom-header__details .custom-header__dropdown-panel {
      position: static;
      box-shadow: none;
      border: none;
      margin-top: 0;
      padding-left: 0.5rem;
    }

    .custom-header__mega-panel {
      display: none !important;
    }
  }

  .custom-header__drawer-mega-image-link {
    display: block;
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 1rem;
  }

  .custom-header__drawer-mega-image {
    width: 100%;
    height: auto;
    display: block;
  }

  .custom-header__drawer-mega-image-title {
    display: block;
    padding: 0.5rem;
    font-weight: 600;
    color: var(--custom-header-text);
  }

  .custom-header__drawer-mega-column {
    margin-bottom: 1rem;
  }

  .custom-header__drawer-mega-heading {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.8;
    display: block;
    margin-bottom: 0.5rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Custom Header",
  "tag": "header",
  "class": "custom-header-section",
  "blocks": [
    {
      "type": "mega_menu_column",
      "name": "Mega menu column",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Column heading",
          "default": "COLLECTIONS"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Links",
          "info": "Up to 6 links shown per column"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Left: Mega Menu & Flower Match Maker"
    },
    {
      "type": "text",
      "id": "mega_menu_trigger_label",
      "label": "Mega menu trigger label",
      "default": "SHOP",
      "info": "Button text that opens the mega menu (e.g. SHOP). Shows ▲ when open, ▼ when closed."
    },
    {
      "type": "range",
      "id": "mega_menu_columns_count",
      "label": "Number of columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4,
      "info": "Add columns using blocks below"
    },
    {
      "type": "select",
      "id": "mega_menu_panel_align",
      "label": "Mega menu panel alignment",
      "options": [
        { "value": "full-width", "label": "Full width" },
        { "value": "page-width", "label": "Page width" },
        { "value": "center", "label": "Center" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Mega menu image (optional)"
    },
    {
      "type": "image_picker",
      "id": "mega_menu_image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "mega_menu_image_position",
      "label": "Image position",
      "options": [
        { "value": "first", "label": "First (left)" },
        { "value": "last", "label": "Last (right)" }
      ],
      "default": "first",
      "visible_if": "{{ section.settings.mega_menu_image != blank }}"
    },
    {
      "type": "text",
      "id": "mega_menu_image_title",
      "label": "Image overlay title",
      "visible_if": "{{ section.settings.mega_menu_image != blank }}"
    },
    {
      "type": "text",
      "id": "mega_menu_image_subtitle",
      "label": "Image overlay subtitle",
      "visible_if": "{{ section.settings.mega_menu_image != blank }}"
    },
    {
      "type": "url",
      "id": "mega_menu_image_link",
      "label": "Image link",
      "visible_if": "{{ section.settings.mega_menu_image != blank }}"
    },
    {
      "type": "color",
      "id": "mega_menu_bg_color",
      "label": "Mega menu panel background",
      "default": "#fdfcfc"
    },
    {
      "type": "header",
      "content": "Flower Match Maker"
    },
    {
      "type": "checkbox",
      "id": "show_flower_match_maker",
      "label": "Show Flower Match Maker button",
      "default": true
    },
    {
      "type": "url",
      "id": "flower_match_maker_url",
      "label": "Flower Match Maker URL"
    },
    {
      "type": "text",
      "id": "flower_match_maker_text",
      "label": "Flower Match Maker button text",
      "default": "FLOWER MATCH MAKER"
    },
    {
      "type": "header",
      "content": "Center: Logo"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo image",
      "info": "If set, replaces text logo"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "HEIRLOOM"
    },
    {
      "type": "checkbox",
      "id": "show_logo_flower_icon",
      "label": "Show flower icon next to logo text",
      "default": true
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height",
      "min": 24,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Right: Learn, About & Search"
    },
    {
      "type": "link_list",
      "id": "menu_learn",
      "label": "LEARN menu",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "menu_about",
      "label": "ABOUT menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search icon",
      "default": true
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F9F0F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text and icons color",
      "default": "#6B1A2A"
    }
  ],
  "presets": [
    {
      "name": "Custom Header",
      "blocks": [
        {
          "type": "mega_menu_column",
          "settings": { "heading": "COLLECTIONS", "menu": "main-menu" }
        },
        {
          "type": "mega_menu_column",
          "settings": { "heading": "ALL FLOWERS", "menu": "main-menu" }
        },
        {
          "type": "mega_menu_column",
          "settings": { "heading": "PLANT CARE", "menu": "main-menu" }
        }
      ]
    }
  ]
}
{% endschema %}
