{% comment %}
  Custom Header - Standalone 3-column header
  Left: Mega Menu (SHOP) + Flower Match Maker pill button
  Center: Logo (flower icon + HEIRLOOM or image)
  Right: LEARN dropdown + ABOUT dropdown + Search
{% endcomment %}

{% liquid
  assign menu_learn = section.settings.menu_learn
  assign menu_about = section.settings.menu_about
  assign mega_trigger_label = section.settings.mega_menu_trigger_label | default: 'SHOP'
  assign mega_columns_count = section.settings.mega_menu_columns_count | default: 4
  assign mega_panel_align = section.settings.mega_menu_panel_align | default: 'page-width'
  assign mega_image = section.settings.mega_menu_image
  assign mega_image_position = section.settings.mega_menu_image_position | default: 'first'
  assign mega_columns = section.blocks | where: 'type', 'mega_menu_column'
  assign form_style = localization_font | append: localization_font_size | append: color_shadow
  assign has_mega_content = false
  if mega_columns.size > 0 or mega_image != blank
    assign has_mega_content = true
  endif
%}

<header
  class="custom-header section section--{{ section.settings.section_width }}"
  role="banner"
 style="
    --custom-header-bg: {{ section.settings.background_color }};
    --custom-header-text: {{ section.settings.text_color }};
    --custom-header-logo-height: {{ section.settings.logo_height }}px;
    --custom-header-mega-bg: {{ section.settings.mega_menu_bg_color | default: '#fdfcfc' }};
  " 
>
  <div class="custom-header__container">
    {% comment %} Left: Mega Menu trigger + Flower Match Maker {% endcomment %}
    <div class="custom-header__column custom-header__column--left">
      <nav class="custom-header__nav custom-header__nav--left" aria-label="{{ 'accessibility.header_navigation_label' | t | default: 'Header navigation' }}">
        {% if has_mega_content %}
          <div class="custom-header__mega-wrap">
            <details class="custom-header__details custom-header__details--mega" data-mega-menu>
              <summary class="custom-header__summary" aria-expanded="false" aria-haspopup="true">
                <span class="custom-header__label">{{ mega_trigger_label }}</span>
                <span class="custom-header__caret svg-wrapper icon-caret">
                  {{ 'icon-caret.svg' | inline_asset_content }}
                </span>
              </summary>
              <div class="custom-header__mega-panel" data-mega-panel>
                <div class="custom-header__mega-inner custom-header__mega-inner--{{ mega_panel_align }}">
                  {% if mega_image != blank and mega_image_position == 'first' %}
                    <div class="custom-header__mega-image custom-header__mega-image--first">
                      {% if section.settings.mega_menu_image_link != blank %}
                        <a href="{{ section.settings.mega_menu_image_link }}" class="custom-header__mega-image-link">
                      {% endif %}
                      <div class="custom-header__mega-image-inner">
                        <img
                          src="{{ mega_image | image_url: width: 400 }}"
                          alt="{{ section.settings.mega_menu_image_title | default: '' }}"
                          width="240"
                          height="320"
                          loading="lazy"
                          class="custom-header__mega-image-img"
                        >
                        <div class="custom-header__mega-image-overlay">
                          {% if section.settings.mega_menu_image_title != blank %}
                            <span class="custom-header__mega-image-title">{{ section.settings.mega_menu_image_title }}</span>
                          {% endif %}
                          {% if section.settings.mega_menu_image_subtitle != blank %}
                            <span class="custom-header__mega-image-subtitle">{{ section.settings.mega_menu_image_subtitle }}</span>
                          {% endif %}
                          <span class="custom-header__mega-image-arrow" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                          </span>
                        </div>
                      </div>
                      {% if section.settings.mega_menu_image_link != blank %}
                        </a>
                      {% endif %}
                    </div>
                  {% endif %}

                  <div class="custom-header__mega-columns">
                    {% for block in mega_columns limit: mega_columns_count %}
                      <div class="custom-header__mega-column" {{ block.shopify_attributes }}>
                        {% if block.settings.heading != blank %}
                          <p class="custom-header__mega-column-heading">{{ block.settings.heading }}</p>
                        {% endif %}
                        {% if block.settings.menu.links.size > 0 %}
                          <ul class="custom-header__mega-column-list list-unstyled" role="list">
                            {% for link in block.settings.menu.links limit: 6 %}
                              <li>
                                <a href="{{ link.url }}" class="custom-header__mega-column-link{% if link.active %} custom-header__mega-column-link--active{% endif %}">{{ link.title }}</a>
                              </li>
                            {% endfor %}
                          </ul>
                        {% endif %}
                      </div>
                    {% endfor %}
                  </div>

                  {% if mega_image != blank and mega_image_position == 'last' %}
                    <div class="custom-header__mega-image custom-header__mega-image--last">
                      {% if section.settings.mega_menu_image_link != blank %}
                        <a href="{{ section.settings.mega_menu_image_link }}" class="custom-header__mega-image-link">
                      {% endif %}
                      <div class="custom-header__mega-image-inner">
                        <img
                          src="{{ mega_image | image_url: width: 400 }}"
                          alt="{{ section.settings.mega_menu_image_title | default: '' }}"
                          width="240"
                          height="320"
                          loading="lazy"
                          class="custom-header__mega-image-img"
                        >
                        <div class="custom-header__mega-image-overlay">
                          {% if section.settings.mega_menu_image_title != blank %}
                            <span class="custom-header__mega-image-title">{{ section.settings.mega_menu_image_title }}</span>
                          {% endif %}
                          {% if section.settings.mega_menu_image_subtitle != blank %}
                            <span class="custom-header__mega-image-subtitle">{{ section.settings.mega_menu_image_subtitle }}</span>
                          {% endif %}
                          <span class="custom-header__mega-image-arrow" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                          </span>
                        </div>
                      </div>
                      {% if section.settings.mega_menu_image_link != blank %}
                        </a>
                      {% endif %}
                    </div>
                  {% endif %}
                </div>
              </div>
            </details>
          </div>
        {% endif %}

        {% if section.settings.show_flower_match_maker and section.settings.flower_match_maker_url != blank %}
          <a
            href="{{ section.settings.flower_match_maker_url }}"
            class="custom-header__pill custom-header__pill--flower"
          >
            <span class="custom-header__pill-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2c-.96 0-1.88.23-2.72.64C7.82 3.5 7 4.95 7 6.5c0 1.36.58 2.58 1.5 3.44L12 14l3.5-4.06C16.42 9.08 17 7.86 17 6.5c0-1.55-.82-3-2.28-3.86C13.88 2.23 12.96 2 12 2zm0 12l-2.5 2.9C8.5 18.5 7 21 7 24h10c0-3-1.5-5.5-2.5-7.1L12 14z"/>
              </svg>
            </span>
            <span>{{ section.settings.flower_match_maker_text | default: 'FLOWER MATCH MAKER' }}</span>
          </a>
        {% endif %}
      </nav>
    </div>

    {% comment %} Center: Logo {% endcomment %}
    <div class="custom-header__column custom-header__column--center">
      <a href="{{ routes.root_url }}" class="custom-header__logo" aria-label="{{ shop.name }}">
        {% if section.settings.logo_image != blank %}
          <img
            src="{{ section.settings.logo_image | image_url: width: 400 }}"
            alt="{{ section.settings.logo_text | default: shop.name }}"
            class="custom-header__logo-image"
            width="{{ section.settings.logo_image.width }}"
            height="{{ section.settings.logo_image.height }}"
            loading="eager"
          >
        {% else %}
          {% if section.settings.show_logo_flower_icon %}
            <span class="custom-header__logo-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2c-.96 0-1.88.23-2.72.64C7.82 3.5 7 4.95 7 6.5c0 1.36.58 2.58 1.5 3.44L12 14l3.5-4.06C16.42 9.08 17 7.86 17 6.5c0-1.55-.82-3-2.28-3.86C13.88 2.23 12.96 2 12 2zm0 12l-2.5 2.9C8.5 18.5 7 21 7 24h10c0-3-1.5-5.5-2.5-7.1L12 14z"/>
              </svg>
            </span>
          {% endif %}
          <span class="custom-header__logo-text">{{ section.settings.logo_text | default: 'HEIRLOOM' }}</span>
        {% endif %}
      </a>
    </div>

    {% comment %} Right: LEARN + ABOUT + Search {% endcomment %}
    <div class="custom-header__column custom-header__column--right">
      <nav class="custom-header__nav custom-header__nav--right" aria-label="{{ 'accessibility.header_navigation_label' | t | default: 'Header navigation' }}">
        {% if menu_learn.links.size > 0 %}
          <div class="custom-header__dropdown">
            <details class="custom-header__details">
              <summary class="custom-header__summary" aria-expanded="false" aria-haspopup="true">
                <span class="custom-header__label">{{ menu_learn.title | default: 'LEARN' }}</span>
                <span class="custom-header__caret svg-wrapper icon-caret">
                  {{ 'icon-caret.svg' | inline_asset_content }}
                </span>
              </summary>
              <div class="custom-header__dropdown-panel">
                <ul class="custom-header__dropdown-list list-unstyled" role="list">
                  {% for link in menu_learn.links %}
                    <li>
                      <a href="{{ link.url }}" class="custom-header__dropdown-link{% if link.active %} custom-header__dropdown-link--active{% endif %}">{{ link.title }}</a>
                      {% if link.links.size > 0 %}
                        <ul class="custom-header__dropdown-sublist list-unstyled" role="list">
                          {% for child in link.links %}
                            <li><a href="{{ child.url }}" class="custom-header__dropdown-link custom-header__dropdown-link--child">{{ child.title }}</a></li>
                          {% endfor %}
                        </ul>
                      {% endif %}
                    </li>
                  {% endfor %}
                </ul>
              </div>
            </details>
          </div>
        {% endif %}

        {% if menu_about.links.size > 0 %}
          <div class="custom-header__dropdown">
            <details class="custom-header__details">
              <summary class="custom-header__summary" aria-expanded="false" aria-haspopup="true">
                <span class="custom-header__label">{{ menu_about.title | default: 'ABOUT' }}</span>
                <span class="custom-header__caret svg-wrapper icon-caret">
                  {{ 'icon-caret.svg' | inline_asset_content }}
                </span>
              </summary>
              <div class="custom-header__dropdown-panel">
                <ul class="custom-header__dropdown-list list-unstyled" role="list">
                  {% for link in menu_about.links %}
                    <li>
                      <a href="{{ link.url }}" class="custom-header__dropdown-link{% if link.active %} custom-header__dropdown-link--active{% endif %}">{{ link.title }}</a>
                      {% if link.links.size > 0 %}
                        <ul class="custom-header__dropdown-sublist list-unstyled" role="list">
                          {% for child in link.links %}
                            <li><a href="{{ child.url }}" class="custom-header__dropdown-link custom-header__dropdown-link--child">{{ child.title }}</a></li>
                          {% endfor %}
                        </ul>
                      {% endif %}
                    </li>
                  {% endfor %}
                </ul>
              </div>
            </details>
          </div>
        {% endif %}

        {% if section.settings.show_search %}
          <div class="custom-header__search">
            {% render 'search', style: 'modal', display_style: 'icon' %}
          </div>
        {% endif %}
      </nav>
    </div>

    {% comment %} Mobile: Hamburger toggle {% endcomment %}
    <button
      type="button"
      class="custom-header__hamburger"
      aria-label="{{ 'accessibility.menu' | t | default: 'Open menu' }}"
      aria-expanded="false"
      aria-controls="custom-header-mobile-drawer-{{ section.id }}"
      data-mobile-toggle
    >
      <span class="custom-header__hamburger-icon custom-header__hamburger-icon--open">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </span>
      <span class="custom-header__hamburger-icon custom-header__hamburger-icon--close" hidden>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </span>
    </button>
  </div>

  {% comment %} Mobile drawer {% endcomment %}
  <div id="custom-header-mobile-drawer-{{ section.id }}" class="custom-header__drawer" hidden data-mobile-drawer >
    <div class="custom-header__hamburger-icon-mobile custom-header__hamburger-icon--close" >
      <div class="header-back-button">
        <span class="svg-wrapper icon-caret">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M11 5.5L7 9.5L3 5.5" stroke="currentColor" stroke-width="var(--icon-stroke-width)" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </span>
        <span class="text-back">ALL</span>
      </div>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
    </div>
    <div class="custom-header__drawer-inner">
      {% if has_mega_content %}
        <div class="custom-header__drawer-block custom-header__drawer-mega">
          {% comment %} {% if mega_image != blank and section.settings.mega_menu_image_link != blank %} {% endcomment %}
            <a href="{{ section.settings.mega_menu_image_link }}" class="custom-header__drawer-mega-image-link">
              <img src="{{ mega_image | image_url: width: 300 }}" alt="" class="custom-header__drawer-mega-image" loading="lazy" width="300" height="200">
              <div class="custom-header__mega-image-overlay">
                {% if section.settings.mega_menu_image_title != blank %}
                  <span class="custom-header__mega-image-title">{{ section.settings.mega_menu_image_title }}</span>
                {% endif %}
                {% if section.settings.mega_menu_image_subtitle != blank %}
                  <span class="custom-header__mega-image-subtitle">{{ section.settings.mega_menu_image_subtitle }}</span>
                {% endif %}
                <span class="custom-header__mega-image-arrow" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </span>
              </div>
            </a>
          {% comment %} {% endif %} {% endcomment %}
          <span class="custom-header__drawer-title">{{ mega_trigger_label }}</span>
          {% for block in mega_columns limit: mega_columns_count %}
            <div class="custom-header__drawer-mega-column">
              {% if block.settings.heading != blank %}
                <span class="custom-header__drawer-mega-heading">{{ block.settings.heading }}</span>
              {% endif %}
              {% if block.settings.menu.links.size > 0 %}
                <ul class="list-unstyled menu-items-mobile" role="list">
                  {% for link in block.settings.menu.links %}
                    <li><a href="{{ link.url }}" class="custom-header__drawer-link">{{ link.title }}</a></li>
                  {% endfor %}
                </ul>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      {% endif %}
      {% if section.settings.show_flower_match_maker and section.settings.flower_match_maker_url != blank %}
        <a href="{{ section.settings.flower_match_maker_url }}" class="custom-header__pill custom-header__pill--flower custom-header__drawer-pill">
          <span class="custom-header__pill-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2c-.96 0-1.88.23-2.72.64C7.82 3.5 7 4.95 7 6.5c0 1.36.58 2.58 1.5 3.44L12 14l3.5-4.06C16.42 9.08 17 7.86 17 6.5c0-1.55-.82-3-2.28-3.86C13.88 2.23 12.96 2 12 2zm0 12l-2.5 2.9C8.5 18.5 7 21 7 24h10c0-3-1.5-5.5-2.5-7.1L12 14z"/></svg>
          </span>
          {{ section.settings.flower_match_maker_text | default: 'FLOWER MATCH MAKER' }}
        </a>
      {% endif %}
      {% if menu_learn.links.size > 0 %}
        <div class="custom-header__drawer-block drawer-other-div">
          <span class="custom-header__drawer-title drawer-other-span">{{ menu_learn.title | default: 'LEARN' }}</span>
          <ul class="list-unstyled menu-items-mobile drawer-other-ul" role="list">
            {% for link in menu_learn.links %}
              <li><a href="{{ link.url }}" class="custom-header__drawer-link drawer-other-link">{{ link.title }}</a></li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}
      {% if menu_about.links.size > 0 %}
        <div class="custom-header__drawer-block drawer-other-div">
          <span class="custom-header__drawer-title drawer-other-span">{{ menu_about.title | default: 'ABOUT' }}</span>
          <ul class="list-unstyled menu-items-mobile drawer-other-ul" role="list">
            {% for link in menu_about.links %}
              <li><a href="{{ link.url }}" class="custom-header__drawer-link drawer-other-link">{{ link.title }}</a></li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}
    </div>
    <div class="divider"></div>

    <div class="announcement-actions">
      {% comment %} {% if section.settings.show_zone_indicator %} {% endcomment %}
        <div class="custom-announcement-bar__zone-indicator">
          {% render 'component-location-detector' %}
        </div>
      {% comment %} {% endif %} {% endcomment %}
      <div class="custom-announcement-bar__account">
          <div class="account-button custom-announcement-bar__action-button color-{{ settings.popover_color_scheme }}">
            <shopify-account menu="{{ section.settings.customer_account_menu }}">
              {% if customer %}
                <div class="account-button__fallback"></div>
              {% else %}
                <span
                  slot="signed-out-avatar"
                  class="custom-announcement-bar__account-icon"
                  aria-hidden="true"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="15"
                    height="17"
                    viewBox="0 0 15 17"
                    fill="none"
                    class="account-button__icon"
                  >
                    <path
                      stroke="currentColor"
                      stroke-linejoin="round"
                      stroke-width="var(--icon-stroke-width)"
                      d="M10.375 3.813a3.063 3.063 0 1 1-6.125 0 3.063 3.063 0 0 1 6.125 0ZM7.313 9.5c-3.667 0-6.24 2.691-6.563 6.125h13.125C13.552 12.191 10.979 9.5 7.312 9.5Z"
                    />
                  </svg>
                </span>
                <span
                  slot="signed-out-avatar"
                  class="account-button__text custom-announcement-bar__action-text"
                >
                  {{ 'content.account_title' | t }}
                </span>
              {% endif %}
            </shopify-account>
          </div>
      </div>

        <div class="custom-announcement-bar__wishlist">
          <a
            href="{{ section.settings.wishlist_url | default: '/pages/wishlist' }}"
            class="custom-announcement-bar__action-button custom-announcement-bar__wishlist-link"
            aria-label="{{ 'content.wishlist' | t | default: 'Wishlist' }}"
          >
            <span class="custom-announcement-bar__action-text">
              {{ 'content.wishlist' | t | default: 'Wishlist' }}
            </span>
            <span class="svg-wrapper" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.29 1.51 4.04 3 5.5l7 7Z"/>
              </svg>
            </span>
          </a>
        </div>

        {% comment %} {% if section.settings.show_cart %} {% endcomment %}
          <script
            type="module"
            src="{{ 'cart-icon.js' | asset_url }}"
            fetchpriority="low"
          ></script>

          {% if template.name != 'cart' %}
            <script
              src="{{ 'cart-drawer.js' | asset_url }}"
              type="module"
              fetchpriority="low"
            ></script>
            <button
              type="button"
              class="custom-announcement-bar__action-button custom-announcement-bar__cart-link custom-announcement-bar__cart-trigger button-unstyled"
              aria-label="{{ 'accessibility.cart' | t }}"
              aria-describedby="cart-bubble-text-{{ section.id }}"
              aria-haspopup="dialog"
              data-announcement-bar-cart-trigger
              data-cart-url="{{ routes.cart_url }}"
            >
              <cart-icon
                class="custom-announcement-bar__cart-icon{% unless cart == empty %} custom-announcement-bar__cart-icon--has-cart{% endunless %}"
                data-testid="cart-icon"
              >
                <span class="svg-wrapper" aria-hidden="true">
                  {{ 'icon-cart.svg' | inline_asset_content }}
                </span>
                <span class="custom-announcement-bar__action-text">
                  {{ 'content.cart_title_custom' | t }}
                </span>
                {% render 'cart-bubble', limit: 100, live_region: true %}
              </cart-icon>
            </button>
          {% else %}
            <a
              href="{{ routes.cart_url }}"
              class="custom-announcement-bar__action-button custom-announcement-bar__cart-link"
              aria-label="{{ 'accessibility.cart' | t }}"
              aria-describedby="cart-bubble-text-{{ section.id }}"
            >
              <cart-icon
                class="custom-announcement-bar__cart-icon{% unless cart == empty %} custom-announcement-bar__cart-icon--has-cart{% endunless %}"
                data-testid="cart-icon"
              >
                <span class="custom-announcement-bar__action-text">
                  {{ 'content.cart_title' | t }}
                </span>
                <span class="svg-wrapper" aria-hidden="true">
                  {{ 'icon-cart.svg' | inline_asset_content }}
                </span>
                {% render 'cart-bubble', limit: 100, live_region: true %}
              </cart-icon>
            </a>
          {% endif %}
        {% comment %} {% endif %} {% endcomment %}
        {% comment %} {% if section.settings.show_country_selector %} {% endcomment %}
          {% comment %} {% if show_country %} {% endcomment %}
            <dropdown-localization-component class="dropdown-localization">
              <button
                type="button"
                class="button dropdown-localization__button localization-selector custom-announcement-bar__localization-button"
                aria-expanded="false"
                aria-controls="dropdown-localization-results-{{ section.id }}"
                ref="button"
                on:click="/toggleSelector"
                style="{{ localization_font }} {{ localization_font_size }}"
              >
                  {% comment %} {% if section.settings.country_selector_style == true %} {% endcomment %}
                    <span
                      class="icon-flag"
                      style="
                        background-image: url({{- localization.country | image_url: width: 32 }});
                        --size-shadow: 2px;
                        --color-shadow: rgb(var(--color-foreground-rgb) / var(--opacity-30-60));
                      "
                    ></span>
                  {% comment %} {% endif %} {% endcomment %}
                  <span class="currency-code" data-testid="localization-currency-code">
                    {{- localization.country.currency.iso_code -}}
                  </span>
                <span class="visually-hidden" data-testid="localization-visually-hidden">
                  {{- 'accessibility.localization_region_and_language' | t -}}
                </span>

                
