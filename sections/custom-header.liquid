                class="localization-wrapper {{ section.settings.localization_position }}-bound color-{{ settings.popover_color_scheme }}"
                hidden
                ref="panel"
              >
                {% render 'localization-form',
                  show_country: true,
                  show_language: false,
                  localization_style: 'dropdown',
                  form_style: form_style,
                  form_id: section.id
                %}
              </div>
            </dropdown-localization-component>
          {% comment %} {% endif %} {% endcomment %}
        {% comment %} {% endif %} {% endcomment %}

      </div>
     <div class="divider-md"></div>
    </div>
</header>

<script>
  (function() {
    const sectionId = '{{ section.id }}';
    const header = document.querySelector('.custom-header');
    if (!header) return;

    const toggle = header.querySelector('[data-mobile-toggle]');
    const drawer = header.querySelector('[data-mobile-drawer]');
    if (!toggle || !drawer) return;

    toggle.addEventListener('click', function() {
      const open = drawer.hidden;
      drawer.hidden = !open;
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      toggle.querySelector('.custom-header__hamburger-icon--open').hidden = open;
      toggle.querySelector('.custom-header__hamburger-icon--close').hidden = !open;
      document.body.style.overflow = open ? 'hidden' : '';
    });

    header.querySelectorAll('.custom-header__details').forEach(function(details) {
      const summary = details.querySelector('.custom-header__summary');
      if (!summary) return;
      details.addEventListener('toggle', function() {
        summary.setAttribute('aria-expanded', details.open);
      });
      summary.setAttribute('aria-expanded', details.open);
    });
    

     /* -----------------------------
      MEGA MENU NAVIGATION
      ----------------------------- */

      const mega = header.querySelector('.custom-header__drawer-mega');
      if(!mega) return;

      const title = mega.querySelector('.custom-header__drawer-title');
      const columns = mega.querySelectorAll('.custom-header__drawer-mega-column');
      const headings = mega.querySelectorAll('.custom-header__drawer-mega-heading');
      const backBtn = header.querySelector('.header-back-button');

      /* LEVEL 1 → LEVEL 2 */
      if(title){
        title.addEventListener('click',function(){
          mega.classList.add('active');
          columns.forEach(col=>{
            col.style.display='block';
          });
        });
      }

      /* LEVEL 2 → LEVEL 3 */
      headings.forEach(heading=>{
        heading.addEventListener('click',function(){
          const column = this.closest('.custom-header__drawer-mega-column');
          const menu = column.querySelector('.menu-items-mobile');
          /* remove active from all columns */
          columns.forEach(col=>col.classList.remove('active'));
          /* add active to clicked column */
          column.classList.add('active');
          /* hide all menus */
          mega.querySelectorAll('.menu-items-mobile').forEach(m=>{
            m.style.display='none';
          });
          /* show current menu */
          if(menu){
            menu.style.display='block';
          }
          /* hide headings */
          headings.forEach(h=>{
            h.style.display='none';
          });
        });
      });

      /* BACK BUTTON */
      if(backBtn){
        backBtn.addEventListener('click',function(){
          const activeColumn = mega.querySelector('.custom-header__drawer-mega-column.active');
          /* LEVEL 3 → LEVEL 2 */
          if(activeColumn){
            const menu = activeColumn.querySelector('.menu-items-mobile');
            activeColumn.classList.remove('active');
            if(menu){
              menu.style.display='none';
            }
            headings.forEach(h=>{
              h.style.display='block';
            });
            return;
          }

          /* LEVEL 2 → LEVEL 1 */
          if(mega.classList.contains('active')){
            mega.classList.remove('active');
            columns.forEach(col=>{
              col.style.display='none';
            });
          }
        });
      }

      const drawerBlocks = document.querySelectorAll('.drawer-other-div');

      drawerBlocks.forEach(block => {
        const mainTitle = block.querySelector('.drawer-other-span');
        const mainMenu = block.querySelector('.drawer-other-ul');

        // Toggle level 1 menu
        mainTitle.addEventListener('click', () => {
          block.classList.toggle('active');
        });

        // Handle submenus recursively
        const submenus = block.querySelectorAll('.has-submenu > .submenu-title');

        submenus.forEach(subTitle => {
          subTitle.addEventListener('click', (e) => {
            e.stopPropagation(); // Prevent parent toggle
            const parentLi = subTitle.parentElement;
            const submenu = parentLi.querySelector('.submenu');
            submenu.classList.toggle('active');
          });
        });
      });
  })();
</script>

