<div class="container">
  <div class="section__header text-center">
    <h1 class="h2">{{ 'customer.register.title' | t }}</h1>
  </div>

  {%- form 'create_customer', class: 'form form-width mx-auto', novalidate: 'novalidate' -%}
    {%- if form.errors -%}
      <div class="alert mb-8 bg-error-bg text-error-text" tabindex="-1" autofocus>
        <h2 class="h5 text-current">{{ 'contact.form.error_heading' | t }}</h2>
        <ul class="styled-list">
          {%- for field in form.errors -%}
            <li>
              {%- if field == 'form' -%}
                {{ form.errors.messages[field] }}
              {%- else -%}
                <a class="link text-current" href="#register-{{ field }}">
                  {{- form.errors.translated_fields[field] | capitalize }}
                  {{ form.errors.messages[field] -}}
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    <div class="form__field">
      <label class="label" for="register-first-name">{{ 'customer.register.first_name' | t }}</label>
      <input
        type="text"
        class="input w-full"
        id="register-first-name"
        name="customer[first_name]"
        {%- if form.first_name %}
          value="{{ form.first_name }}"
        {%- endif %}
        autocomplete="given-name"
      >
    </div>

    <div class="form__field">
      <label class="label" for="register-last-name">{{ 'customer.register.last_name' | t }}</label>
      <input
        type="text"
        class="input w-full"
        id="register-last-name"
        name="customer[last_name]"
        {%- if form.last_name %}
          value="{{ form.last_name }}"
        {%- endif %}
        autocomplete="family-name"
      >
    </div>

    <div class="form__field required">
      <label class="label" for="register-email">{{ 'customer.register.email' | t }}</label>
      <input
        type="email"
        class="input w-full"
        id="register-email"
        name="customer[email]"
        {%- if form.email %}
          value="{{ form.email }}"
        {%- endif %}
        autocomplete="email"
        {%- if form.errors contains 'email' %}
          aria-invalid="true"
          aria-describedby="register-email-error"
        {%- endif %}
        aria-required="true"
        required
      >
      {%- if form.errors contains 'email' -%}
        <p class="form__field-error" id="register-email-error">
          {{ form.errors.translated_fields.email | capitalize }}
          {{ form.errors.messages.email }}.
        </p>
      {%- endif -%}
    </div>

    <div class="form__field required">
      <label class="label" for="register-password">{{ 'customer.register.password' | t }}</label>
      <input
        type="password"
        class="input w-full"
        id="register-password"
        name="customer[password]"
        autocomplete="new-password"
        {%- if form.errors contains 'password' %}
          aria-invalid="true"
          aria-describedby="register-password-error"
        {%- endif %}
        aria-required="true"
        required
        onkeyup="validatePassword()"
      >
      <span class="form__field-error" id="password-error" style="display:none; color: red;"></span>
      {%- if form.errors contains 'password' -%}
        <p class="form__field-error" id="register-password-error">
          {{ form.errors.translated_fields.password | capitalize }}
          {{ form.errors.messages.password }}.
        </p>
      {%- endif -%}
    </div>

    <div class="form__field required">
      <label class="label" for="register-confirm-password">{{ 'customer.register.confirm_password' | t }}</label>
      <input
        type="password"
        class="input w-full"
        id="register-confirm-password"
        name="customer[confirm_password]"
        autocomplete="new-password"
        required
        onkeyup="validateConfirmPassword()"
      >
      <span class="form__field-error" id="confirm-password-error" style="display:none; color: red;"></span>
    </div>

    <label for="marketing">
      <input type="checkbox" name="customer[accepts_marketing]" value="true" id="marketing" checked>
      {{ settings.newsletter }}
    </label>

    <div class="mt-6">
      <button class="btn btn--primary w-full register">{{ 'customer.register.submit' | t }}</button>
    </div>

    <p class="mt-8 mb-0 text-center">
      {{ 'customer.register.have_account' | t }}
      <a class="btn btn--primary w-full" href="{{ routes.account_login_url }}">{{ 'customer.register.log_in' | t }}</a>
    </p>
  {%- endform -%}
</div>

<script src="{{ 'register-validate.js' | asset_url }}" defer="defer"></script>
{% schema %}
{
  "name": "Register",
  "class": "cc-main-register section section--template"
}
{% endschema %}
