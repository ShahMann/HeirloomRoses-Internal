<div class="reset-password-bar">
  <div class="container">
    <center style="padding: 5px 0px;">
      <span class="reset-password-value"> {{ section.settings['reset-password-text'] }} </span>
      <a
        href="{{ section.settings.reset-password-url }}"
        style="text-decoration: underline; font-weight: 600; display:inline-block;"
      >
        {{ section.settings['reset-password-url-text'] }}
      </a>
    </center>
  </div>
</div>

{% schema %}
{
  "name": "reset-password",
  "settings": [
    {
      "type": "text",
      "id": "reset-password-text",
      "label": "Enter what you want to see you customer"
    },
    {
        "type": "url",
        "id": "reset-password-url",
        "label": "Enter URL"
      },
      {
        "type": "text",
        "id": "reset-password-url-text",
        "label": "Enter what you want to see you customer instead of URL"
      },
  ],
  "presets" : [
    {
      "name": "reset-password",
    },
  ]
}
{% endschema %}
