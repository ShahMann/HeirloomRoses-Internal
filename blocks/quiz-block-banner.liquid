{% comment %} Custom Block {% endcomment %}
<div class="quiz-block-banner quiz-block-banner--{{ block.settings.position }}" {{ block.shopify_attributes }}>
  <div
    class="quiz-block-banner__card"
    style="--bg: {{ block.settings.background_color }}; --text: {{ block.settings.text_color }};"
  >
    <div class="quiz-block-banner__content">
      <div class="quiz-block-banner__icon">{{- 'Heirloom_logo_icon.svg' | inline_asset_content -}}</div>

      <div class="quiz-block-banner__text">
        {% if block.settings.heading != blank %}
          <h3 class="quiz-block-banner__heading quiz-block-banner__heading--{{ block.settings.heading_font }}">
            {{ block.settings.heading }} →
          </h3>
        {% endif %}

        {% if block.settings.description != blank %}
          <p class="quiz-block-banner__description quiz-block-banner__description--{{ block.settings.description_font }}">
            {{ block.settings.description }}
          </p>
        {% endif %}
      </div>
    </div>

    {% if block.settings.link != blank %}
      <a href="{{ block.settings.link }}" class="quiz-block-banner__link"></a>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .quiz-block-banner {
    position: relative;
    top: 64px;
    left: 0;
    width: 100%;
    display: flex;
    padding-right: 0;
    padding-bottom: 64px;
    pointer-events: none;
    align-items: flex-start;
  }

  .quiz-block-banner--left {
    justify-content: flex-start;
  }
  .quiz-block-banner--center {
    justify-content: center;
  }
  .quiz-block-banner--right {
    justify-content: flex-end;
  }
  .quiz-block-banner__card {
    width: 100%;
    max-width: 100%;
    background: var(--bg);
    color: var(--text);
    padding: 32px;
    border-radius: 28px;
    box-shadow: 0 15px 45px rgba(0, 0, 0, 0.18);
    position: relative;
    pointer-events: auto;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .quiz-block-banner__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 22px 60px rgba(0, 0, 0, 0.22);
  }
  .quiz-block-banner__content {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .quiz-block-banner__text {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .quiz-block-banner__icon {
    min-width: 36px;
    width: 36px;
    line-height: 1;
  }

  .quiz-block-banner__heading {
    margin: 0;
    font-family: "SeasonMix-Regular";
    font-weight: 420;
    font-size: 24px;
    line-height: 90%;
    letter-spacing: 0%;
  }

  .quiz-block-banner__description {
    margin: 0;
    font-family: "SeasonSans-Regular";
    font-weight: 400;
    font-size: 12px;
    line-height: 120%;
    letter-spacing: 3%;
  }

  .quiz-block-banner__link {
    position: absolute;
    inset: 0;
  }

  @media (min-width: 768px) {
    .quiz-block-banner {
      padding-right: 64px;
      padding-bottom: 64px;
    }
    .quiz-block-banner__description {
      font-size: 16px;
    }

    .quiz-block-banner__card {
      max-width: 523px;
      border-radius: 16px;
    }

    .quiz-block-banner__content {
      flex-direction: row;
      align-items: center;
      gap: 32px;
    }

    .quiz-block-banner__icon {
      min-width: 68px;
      width: 68px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.quiz_block_banner",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Flower Finder Quiz"
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "options": [
        {
          "value": "body",
          "label": "t:options.body"
        },
        {
          "value": "subheading",
          "label": "t:options.subheading"
        },
        {
          "value": "heading",
          "label": "t:options.heading"
        },
        {
          "value": "accent",
          "label": "t:options.accent"
        }
      ],
      "default": "heading"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Not sure which rose to choose? In just a few questions, we’ll guide you to the right fit—so you can plant with confidence."
    },
    {
      "type": "select",
      "id": "description_font",
      "label": "Description font",
      "options": [
        {
          "value": "body",
          "label": "t:options.body"
        },
        {
          "value": "subheading",
          "label": "t:options.subheading"
        },
        {
          "value": "heading",
          "label": "t:options.heading"
        },
        {
          "value": "accent",
          "label": "t:options.accent"
        }
      ],
      "default": "heading"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ef426f"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "t:names.quiz_block_banner",
      "category": "t:categories.decorative"
    }
  ]
}
{% endschema %}
