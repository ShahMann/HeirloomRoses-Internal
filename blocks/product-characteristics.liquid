{%- liquid
  assign block_settings = block.settings
-%}

<div
  class="product-characteristics product-characteristics--layout-{{ block_settings.layout }} product-characteristics--text-{{ block_settings.text_alignment }} spacing-style"
  style="{% render 'spacing-style', settings: block_settings %} --product-characteristics-icon-size: {{ block_settings.icon_size }}px;"
  {{ block.shopify_attributes }}
>
  {% render 'product-characteristics',
    product: closest.product,
    icon_size: block_settings.icon_size
  %}
</div>

{% stylesheet %}
  .product-characteristics .character_list {
    display: flex;
    list-style: none;
    padding: 0;
    margin: 0;
    gap: var(--product-characteristics-gap, 12px);
  }

  .product-characteristics--layout-horizontal .character_list {
    flex-direction: row;
    flex-wrap: wrap;
  }

  .product-characteristics--layout-vertical .character_list {
    flex-direction: column;
  }

  .product-characteristics .character_list li {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .product-characteristics--layout-vertical .character_list li {
    flex-direction: column;
  }

  .product-characteristics .character_list img {
    width: var(--product-characteristics-icon-size, 50px);
    height: var(--product-characteristics-icon-size, 50px);
    flex-shrink: 0;
  }

  .product-characteristics--text-left .character_list li {
    justify-content: flex-start;
    text-align: left;
  }

  .product-characteristics--text-center .character_list li {
    justify-content: center;
    text-align: center;
  }

  .product-characteristics--text-right .character_list li {
    justify-content: flex-end;
    text-align: right;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product characteristics",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Displays `product.metafields.custom.characteristic_s_` as icon + label list."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Icon alignment",
      "options": [
        {
          "value": "horizontal",
          "label": "Horizontal"
        },
        {
          "value": "vertical",
          "label": "Vertical"
        }
      ],
      "default": "horizontal"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 50
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Product characteristics",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}

