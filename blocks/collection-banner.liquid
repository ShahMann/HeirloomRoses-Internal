{%- liquid
  assign block_settings = block.settings
  assign banner_collection = collection | default: block.settings.collection
  assign banner_bg = banner_collection.metafields.custom.banner_background_color | default: block_settings.fallback_background_color
  assign sizes_desktop = '(min-width: 768px) 50vw, 100vw'
  assign widths = '416, 600, 832, 1200, 1600, 1920, 2560'
-%}

{% if banner_collection != blank %}
  <div
    class="collection-banner collection-banner--{{ block.id }} spacing-style"
    style="{% render 'spacing-style', settings: block_settings %}"
    {{ block.shopify_attributes }}
  >
    <div
      class="collection-banner__inner collection-banner__inner--height-{{ block_settings.banner_height }}"
      style="--collection-banner-height: var(--collection-banner-height-{{ block_settings.banner_height }});"
    >
      <div class="collection-banner__grid">
        <div
          class="collection-banner__panel collection-banner__panel--text"
          style="
            {% if banner_bg != blank %}background-color: {{ banner_bg }};{% endif %}
            --collection-banner-text-color: {{ block_settings.text_color }};
            --collection-banner-heading-size: var(--collection-banner-heading-{{ block_settings.heading_size }});
            --collection-banner-padding-inline: var(--padding-lg);
            --collection-banner-padding-block: var(--padding-xl);
          "
        >
          <div class="collection-banner__content">
            <h1 class="collection-banner__heading">{{ banner_collection.title }}</h1>
            {% if block_settings.show_description and banner_collection.description != blank %}
              <div class="collection-banner__description rte">
                {{ banner_collection.description }}
              </div>
            {% endif %}
          </div>
        </div>

        <div class="collection-banner__panel collection-banner__panel--image">
          {% if banner_collection.featured_image != blank %}
            {{
              banner_collection.featured_image
              | image_url: width: 2560
              | image_tag:
                loading: 'eager',
                fetchpriority: 'high',
                widths: widths,
                sizes: sizes_desktop,
                class: 'collection-banner__image',
                alt: banner_collection.featured_image.alt | default: banner_collection.title
            }}
          {% else %}
            <div class="collection-banner__placeholder">
              {{ 'collection-1' | placeholder_svg_tag: 'collection-banner__placeholder-svg' }}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
{% endif %}

{% style %}
  #shopify-section-{{ section.id }} .collection-banner__inner {
    --collection-banner-height-small: 280px;
    --collection-banner-height-medium: 360px;
    --collection-banner-height-large: 440px;
    border-radius: var(--border-radius, 0.375rem);
    overflow: hidden;
    min-height: var(--collection-banner-height);
  }

  #shopify-section-{{ section.id }} .collection-banner__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: var(--collection-banner-height);
  }

  #shopify-section-{{ section.id }} .collection-banner__panel {
    display: flex;
    align-items: stretch;
    min-height: 0;
  }

  #shopify-section-{{ section.id }} .collection-banner__panel--text {
    padding: var(--collection-banner-padding-block) var(--collection-banner-padding-inline);
    color: var(--collection-banner-text-color);
    justify-content: center;
    flex-direction: column;
  }

  #shopify-section-{{ section.id }} .collection-banner__content {
    display: flex;
    flex-direction: column;
    gap: var(--padding-md);
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .collection-banner__heading {
    font-family: var(--font-heading--family), serif;
    font-size: var(--collection-banner-heading-size);
    line-height: 1.15;
    margin: 0;
    font-weight: var(--font-heading--weight);
    color: inherit;
  }

  #shopify-section-{{ section.id }} .collection-banner__description {
    font-family: var(--font-body--family), sans-serif;
    font-size: 1rem;
    line-height: 1.5;
    color: inherit;
  }

  #shopify-section-{{ section.id }} .collection-banner__description a {
    color: inherit;
    text-decoration: underline;
  }

  #shopify-section-{{ section.id }} .collection-banner__panel--image {
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .collection-banner__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
  }

  #shopify-section-{{ section.id }} .collection-banner__placeholder {
    width: 100%;
    height: 100%;
    min-height: var(--collection-banner-height);
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgb(var(--color-foreground-rgb) / 0.06);
  }

  #shopify-section-{{ section.id }} .collection-banner__placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Heading size clamps: small, medium, large */
  #shopify-section-{{ section.id }} {
    --collection-banner-heading-small: clamp(1.5rem, 4vw + 1rem, 2.25rem);
    --collection-banner-heading-medium: clamp(2rem, 5vw + 1.25rem, 3rem);
    --collection-banner-heading-large: clamp(2.5rem, 6vw + 1.5rem, 3.75rem);
  }

  @media screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .collection-banner__grid {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr;
    }

    #shopify-section-{{ section.id }} .collection-banner__panel--image {
      order: -1;
      min-height: 220px;
    }

    #shopify-section-{{ section.id }} .collection-banner__image {
      min-height: 220px;
    }

    #shopify-section-{{ section.id }} .collection-banner__inner {
      min-height: 0;
    }

    #shopify-section-{{ section.id }} .collection-banner__panel--text {
      padding: var(--padding-lg) var(--padding-md);
    }

    #shopify-section-{{ section.id }} .collection-banner__heading {
      font-size: clamp(1.25rem, 3vw + 0.875rem, 1.75rem);
    }

    #shopify-section-{{ section.id }} .collection-banner__placeholder {
      min-height: 220px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Collection banner",
  "tag": null,
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "t:settings.collection"
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color",
      "id": "fallback_background_color",
      "label": "t:settings.background_color",
      "info": "Used when collection metafield custom.banner_background_color is not set",
      "default": "#e8e4f0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#5c3d2e"
    },
    {
      "type": "header",
      "content": "t:content.typography"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:settings.heading_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "large",
          "label": "t:options.large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "banner_height",
      "label": "Banner height",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "large",
          "label": "t:options.large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show collection description",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Collection Banner",
      "category": "t:categories.collection"
    }
  ]
}
{% endschema %}
