{%- liquid
  assign characteristics_product = product | default: closest.product
  assign characteristics_list = characteristics_product.metafields.custom.characteristic_s_.value
  assign icon_size_px = icon_size | default: 50
-%}

{%- if characteristics_product != blank and characteristics_list != blank -%}
  <div class="product-block product-block-characteristics">
    <ul class="character_list">
      {%- for characteristic in characteristics_list -%}
        {%- if characteristic contains 'Thornless/Nearly Thornless' -%}
          {%- assign iconsvg = 'Thornless-Nearly Thornless' -%}
        {%- else -%}
          {%- assign iconsvg = characteristic -%}
        {%- endif -%}

        {%- assign icon_asset = iconsvg | handleize | append: '.svg' -%}
        <li>
          <img
            src="{{ icon_asset | asset_url }}"
            width="{{ icon_size_px }}"
            height="{{ icon_size_px }}"
            alt="{{ iconsvg }}"
          >
          {{- characteristic -}}
        </li>
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}
