{%- comment -%}
  Parameters:
  - product {Object} - Product object.

  Usage:
  {% render 'structured-data-product', product: product %}
{%- endcomment -%}

{% comment %} <script type="application/ld+json">
  {{ product | structured_data }}
</script>  {% endcomment %}
<script type="application/ld+json">
  {
    "@context": "http://schema.org/",
    "@id": "{{ product.url }}#product",
    {% if product.variants.size > 1 %}
    "@type": "ProductGroup",
    {% else %}
    "@type": "Product",
    {% endif %}
    "brand": {
      "@type": "Brand",
      "name": "{{ product.vendor | escape }}"
    },
    "category": "{{ product.category | escape }}",
    "description": "{{ product.description | strip_html | strip_newlines | escape }}",
    {% unless product.variants.size > 1 %}
    "image": "{{ shop.url }}/cdn/shop/{{ product.featured_image | image_url: 'master' }}",
    "name": "{{ product.title | escape }}",
    {% endunless %}
    {% if product.variants.size > 1 %}
    "hasVariant": [
      {% for variant in product.variants %}
      {
        "@id": "{{ product.url }}?variant={{ variant.id }}#variant",
        "@type": "Product",
        "image": "{{ shop.url }}/cdn/shop/{{ variant.featured_image | default: product.featured_image | image_url: 'master' }}?variant={{ variant.id }}",
        "name": "{{ product.title | escape }} - {{ variant.title | escape }}",
        "offers": {
          "@id": "{{ product.url }}?variant={{ variant.id }}#offer",
          "@type": "Offer",
          "availability": "{% if variant.available %}http://schema.org/InStock{% else %}http://schema.org/OutOfStock{% endif %}",
          "price": "{{ variant.price | times: settings.tax_value | money_without_currency }}",
          "priceCurrency": "{{ cart.currency.iso_code }}",
          "url": "{{ shop.url }}{{ product.url }}?variant={{ variant.id }}"
        },
        "sku": "{{ variant.sku | escape }}"
      }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ],
    "name": "{{ product.title | escape }}",
    "productGroupID": "{{ product.id }}",
    {% else %}
    "offers": {
      "@id": "{{ product.url }}?variant={{ product.selected_or_first_available_variant.id }}#offer",
      "@type": "Offer",
      "availability": "{% if product.selected_or_first_available_variant.available %}http://schema.org/InStock{% else %}http://schema.org/OutOfStock{% endif %}",
      "price": "{{ product.selected_or_first_available_variant.price| times: settings.tax_value | money_without_currency }}",
      "priceCurrency": "{{ cart.currency.iso_code }}",
      "url": "{{ shop.url }}{{ product.url }}?variant={{ product.selected_or_first_available_variant.id }}"
    },
    "sku": "{{ product.selected_or_first_available_variant.sku | escape }}",
    {% endif %}
    "url": "{{ shop.url }}{{ product.url }}"
  }
</script>